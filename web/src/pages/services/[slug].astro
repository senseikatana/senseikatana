---
import { render } from 'astro:content';
import Base from '../../features/shared/layouts/Base.astro';
import Section from '../../features/shared/components/Section.astro';
import CtaSection from '../../features/shared/components/CtaSection.astro';
import { getServices } from '../../features/services/queries';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<Base title={service.data.title} description={service.data.description}>
  <Section top={false} inner="px-6 pt-16 pb-10 max-md:px-5">
    <p class="flex items-center gap-2 text-[12px] text-smoke">
      <a href="/services" class="hover:text-ink">Servicios</a>
      <span class="text-stone">/</span>
      <span>{service.data.title}</span>
    </p>
    <h1
      class="mt-6 text-[clamp(32px,4.6vw,56px)] leading-[1.04] font-bold tracking-[-0.045em] max-w-[20ch]"
    >
      {service.data.title}
    </h1>
    <p class="mt-5 text-[18px] max-md:text-[15px] leading-[1.5] text-steel max-w-[60ch]">
      {service.data.description}
    </p>
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,680px)_300px] gap-14">
      <div class="prose-content min-w-0"><Content /></div>
      <aside class="space-y-8">
        {
          service.data.deliverables.length > 0 && (
            <div>
              <p class="label">Entregables</p>
              <ul class="mt-4 border-t border-rule">
                {service.data.deliverables.map((item) => (
                  <li class="flex gap-3 py-3 border-b border-rule text-[14px] text-steel">
                    <span class="text-smoke">+</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          service.data.stack.length > 0 && (
            <div>
              <p class="label">Stack</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {service.data.stack.map((tech) => (
                  <li class="border border-rule px-2 py-1 text-[12px] text-smoke">{tech}</li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </Section>

  <CtaSection />
</Base>
