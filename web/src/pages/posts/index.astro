---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostCard from '../../features/blog/components/PostCard.astro';
import { getPosts } from '../../features/blog/queries';
import { getLocale, useTranslations } from '../../i18n';

const locale = getLocale(Astro.url.pathname, Astro.currentLocale);
const tr = useTranslations(locale);
const posts = await getPosts(locale);
---

<Base title={tr('blog.title')} description={tr('blog.subtitle')}>
  <Section top={false} inner="px-6 pt-16 pb-24 max-md:px-5">
    <SectionHead
      idx="01"
      label={tr('blog.label')}
      title={tr('blog.headline')}
      lede={tr('blog.lede')}
      size="lg"
    />
    {
      posts.length === 0 ? (
        <div class="mt-12 max-w-[60ch] border border-rule p-8">
          <p class="label">{tr('blog.label')}</p>
          <p class="mt-3 text-[16px] leading-[1.6] text-steel">{tr('blog.empty')}</p>
        </div>
      ) : (
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </Section>
</Base>
