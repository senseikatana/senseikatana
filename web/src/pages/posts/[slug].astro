---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import Section from '../../components/Section.astro';
import Cover from '../../components/Cover.astro';
import {
  formatDate,
  getPost,
  getPostSlugs,
  getRelated,
  readingTime,
} from '../../features/blog/queries';
import { dateLocales, getLocale, useTranslations } from '../../i18n';
import { contentSlug } from '../../lib/content';
import { articleJsonLd, absoluteUrl } from '../../lib/seo';

const locale = getLocale(Astro.url.pathname, Astro.currentLocale);
const tr = useTranslations(locale);

export async function getStaticPaths() {
  const slugs = await getPostSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const post = await getPost(locale, slug);
if (!post) throw new Error(`Unknown post: ${slug}`);
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const related = await getRelated(locale, slug);
const url = absoluteUrl(`/posts/${slug}`);
const minutes = readingTime(post.body ?? '');
const jsonLd = articleJsonLd({
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  author: post.data.author,
  url,
});
---

<Base title={post.data.title} description={post.data.description} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Section
    top={false}
    inner="px-6 pt-[72px] pb-10 max-md:px-5 max-md:pt-8 max-md:pb-6"
    label="Cabecera del artículo"
  >
    <div class="mb-6"><BackLink href="/posts" /></div>
    <p class="flex items-center gap-2 text-[12px] text-smoke">
      <a href="/posts" class="hover:text-ink">{tr('blog.title')}</a>
      {post.data.tags[0] && <span class="text-stone">/</span>}
      {
        post.data.tags[0] && (
          <span class="pill bg-ink text-canvas uppercase tracking-[0.06em] !text-[10px]">
            {post.data.tags[0]}
          </span>
        )
      }
    </p>
    <h1
      class="mt-6 text-[clamp(32px,4.6vw,56px)] leading-[1.04] font-bold tracking-[-0.045em] max-w-[22ch]"
      transition:name={`post-title-${slug}`}
    >
      {post.data.title}
    </h1>
    <p class="mt-5 text-[18px] max-md:text-[15px] leading-[1.5] text-steel max-w-[60ch]">
      {post.data.description}
    </p>
    <div
      class="mt-7 pt-[18px] border-t border-rule flex flex-wrap items-center gap-x-6 gap-y-3 text-[13px]"
    >
      <span class="font-bold text-ink">{post.data.author}</span>
      <span class="text-smoke"
        >{formatDate(post.data.date, dateLocales[locale])} · {
          tr('blog.readingTime').replace('{minutes}', String(minutes))
        }</span
      >
    </div>
  </Section>

  <Section top={false} inner="px-6 pb-14 max-md:px-5 max-md:pb-6" label={tr('blog.cover')}>
    <div class="border border-ink">
      {
        post.data.image ? (
          <img src={post.data.image} alt="" class="aspect-[16/9] w-full object-cover" />
        ) : (
          <Cover kind={0} label={tr('blog.cover')} class="!aspect-[12/5] max-md:!aspect-[16/10]" />
        )
      }
    </div>
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5 max-md:pb-12" label="Artículo">
    <div
      class="grid grid-cols-[200px_minmax(0,680px)_220px] max-xl:grid-cols-[minmax(0,680px)_220px] max-lg:grid-cols-1 gap-14 max-lg:gap-6 justify-between"
    >
      <aside class="max-xl:hidden space-y-[18px] pt-1.5 text-[13px]">
        {
          [
            [tr('blog.writtenBy'), post.data.author],
            [tr('blog.published'), formatDate(post.data.date, dateLocales[locale])],
            [tr('blog.reading'), `${minutes} min`],
          ].map(([key, value]) => (
            <div>
              <p class="label">{key}</p>
              <p class="mt-1 text-ink">{value}</p>
            </div>
          ))
        }
      </aside>
      <div class="prose-content min-w-0"><Content /></div>
      {
        toc.length > 0 && (
          <aside class="max-lg:order-first lg:sticky lg:top-20 h-fit">
            <p class="label">{tr('blog.onThisPage')}</p>
            <ul class="mt-3 space-y-2 text-[13px]">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class="text-steel hover:text-ink">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </Section>

  {
    related.length > 0 && (
      <Section inner="px-6 py-14 max-md:px-5 border-t border-rule" label="Relacionados">
        <p class="label">{tr('blog.keepReading')}</p>
        <ul class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-6">
          {related.map((item) => (
            <li>
              <a href={`/posts/${contentSlug(item.id)}`} class="block group">
                <span class="text-[12px] text-smoke">
                  {formatDate(item.data.date, dateLocales[locale])}
                </span>
                <span class="mt-1 block text-[16px] font-bold tracking-[-0.02em] group-hover:text-link">
                  {item.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Base>
