---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../features/projects/components/ProjectCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getProjects } from '../../features/projects/queries';
import { getLocale, useTranslations } from '../../i18n';

const locale = getLocale(Astro.url.pathname, Astro.currentLocale);
const tr = useTranslations(locale);
const projects = await getProjects(locale);
---

<Base title={tr('works.title')} description={tr('works.subtitle')}>
  <Section top={false} inner="px-6 pt-16 pb-14 max-md:px-5">
    <SectionHead
      idx="01"
      label={tr('works.label')}
      title={tr('works.headline')}
      lede={tr('works.subtitle')}
      size="lg"
    />
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5">
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        projects.map((project) => (
          <li class="contents">
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaSection title={tr('works.ctaTitle')} lede={tr('works.ctaBody')} />
</Base>
