---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import Section from '../../components/Section.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getProject, getProjectSlugs } from '../../features/projects/queries';
import { getLocale, useTranslations } from '../../i18n';
import { contentSlug } from '../../lib/content';

const locale = getLocale(Astro.url.pathname, Astro.currentLocale);
const tr = useTranslations(locale);

export async function getStaticPaths() {
  const slugs = await getProjectSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const project = await getProject(locale, slug);
if (!project) throw new Error(`Unknown project: ${slug}`);
const { Content } = await render(project);
const beats = [
  [tr('works.challenge'), project.data.challenge],
  [tr('works.solution'), project.data.solution],
  [tr('works.outcome'), project.data.outcome],
].filter(([, body]) => Boolean(body)) as [string, string][];
---

<Base title={project.data.title} description={project.data.description}>
  <Section top={false} inner="px-6 pt-16 pb-10 max-md:px-5">
    <div class="mb-6"><BackLink href="/projects" /></div>
    <p class="flex items-center gap-2 text-[12px] text-smoke">
      <a href="/projects" class="hover:text-ink">{tr('works.title')}</a>
      <span class="text-stone">/</span>
      <span>{project.data.title}</span>
    </p>
    <h1
      class="mt-6 text-[clamp(32px,4.6vw,56px)] leading-[1.04] font-bold tracking-[-0.045em] max-w-[20ch]"
      transition:name={`project-title-${contentSlug(project.id)}`}
    >
      {project.data.title}
    </h1>
    <p class="mt-5 text-[18px] max-md:text-[15px] leading-[1.5] text-steel max-w-[60ch]">
      {project.data.description}
    </p>
    <div class="mt-8 pt-5 border-t border-rule flex flex-wrap gap-x-10 gap-y-4 text-[13px]">
      {
        project.data.client && (
          <span>
            <>
              <span class="label block">{tr('works.client')}</span>
              <span class="text-ink">{project.data.client}</span>
            </>
          </span>
        )
      }
      {
        project.data.sector && (
          <span>
            <>
              <span class="label block">{tr('works.sector')}</span>
              <span class="text-ink">{project.data.sector}</span>
            </>
          </span>
        )
      }
      {
        project.data.year && (
          <span>
            <>
              <span class="label block">{tr('works.year')}</span>
              <span class="text-ink">{project.data.year}</span>
            </>
          </span>
        )
      }
      {
        project.data.role && (
          <span>
            <>
              <span class="label block">{tr('works.role')}</span>
              <span class="text-ink">{project.data.role}</span>
            </>
          </span>
        )
      }
      {
        project.data.liveUrl && (
          <span>
            <>
              <span class="label block">{tr('works.visit')}</span>
              <a href={project.data.liveUrl} class="link">
                {new URL(project.data.liveUrl).hostname} -&gt;
              </a>
            </>
          </span>
        )
      }
      {
        project.data.repoUrl && (
          <span>
            <>
              <span class="label block">{tr('works.repo')}</span>
              <a href={project.data.repoUrl} class="link">
                {tr('works.repo')} -&gt;
              </a>
            </>
          </span>
        )
      }
    </div>
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,680px)_300px] gap-14">
      <div>
        {
          beats.length > 0 && (
            <dl class="border-t border-rule">
              {beats.map(([title, body]) => (
                <div class="grid grid-cols-[140px_1fr] max-md:grid-cols-1 gap-4 py-6 border-b border-rule">
                  <dt class="label pt-1">{title}</dt>
                  <dd class="text-[15px] leading-[1.6] text-steel">{body}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="prose-content mt-10 min-w-0"><Content /></div>
      </div>
      <aside class="space-y-8">
        {
          project.data.stack.length > 0 && (
            <div>
              <p class="label">{tr('works.stack')}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {project.data.stack.map((tech) => (
                  <li class="border border-rule px-2 py-1 text-[12px] text-smoke">{tech}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          project.data.metrics.length > 0 && (
            <div>
              <p class="label">{tr('works.metrics')}</p>
              <dl class="mt-4 border-t border-rule">
                {project.data.metrics.map((metric) => (
                  <div class="py-3 border-b border-rule">
                    <dd class="text-[18px] font-bold text-ink">{metric.value}</dd>
                    <dt class="label">{metric.label}</dt>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </aside>
    </div>
  </Section>

  <CtaSection />
</Base>
