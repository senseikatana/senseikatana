---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactForm from '../features/contact/components/ContactForm.astro';
import { site } from '../config/site';
import { getLocale, useTranslations } from '../i18n';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';

const whatsapp = `https://wa.me/${site.contact.whatsapp}?${new URLSearchParams({
  text: tr('contact.whatsappMessage'),
})}`;
const telegram = site.contact.telegram ? `https://t.me/${site.contact.telegram}` : '';
---

<Base title={tr('contact.title')} description={tr('contact.subtitle')}>
  <Section top={false} inner="px-6 pt-16 pb-24 max-md:px-5">
    <SectionHead
      idx="01"
      label={tr('contact.label')}
      title={tr('contact.subtitle')}
      lede={tr('contact.intro')}
      size="lg"
    />

    <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
      <ContactForm endpoint={endpoint} />

      <aside class="space-y-8">
        <div>
          <p class="label">{tr('contact.channels')}</p>
          <a href={whatsapp} class="btn btn-primary mt-4 w-full" rel="noopener">WhatsApp -&gt;</a>
          {
            telegram && (
              <a href={telegram} class="btn btn-ghost btn-s mt-2 w-full" rel="noopener">
                Telegram -&gt;
              </a>
            )
          }
          <p class="mt-3 text-[13px] text-smoke">{tr('contact.whatsappHint')}</p>
        </div>

        <ul class="border-t border-rule">
          <li class="border-b border-rule">
            <a
              href={`mailto:${site.contact.email}`}
              class="group flex items-center justify-between py-4"
            >
              <span>
                <span class="block text-[15px] font-bold text-ink group-hover:text-link"
                  >{tr('contact.emailAction')}</span
                >
                <span class="mt-1 block text-[13px] text-smoke">{site.contact.email}</span>
              </span>
              <span class="text-stone" aria-hidden="true">-&gt;</span>
            </a>
          </li>
          <li class="border-b border-rule">
            <a
              href={`tel:${site.contact.phone}`}
              class="group flex items-center justify-between py-4"
            >
              <span>
                <span class="block text-[15px] font-bold text-ink group-hover:text-link"
                  >{tr('contact.callAction')}</span
                >
                <span class="mt-1 block text-[13px] text-smoke">{site.contact.phoneDisplay}</span>
              </span>
              <span class="text-stone" aria-hidden="true">-&gt;</span>
            </a>
          </li>
          <li class="border-b border-rule">
            <a
              href={site.social.linkedin}
              class="group flex items-center justify-between py-4"
              rel="me noopener"
            >
              <span>
                <span class="block text-[15px] font-bold text-ink group-hover:text-link"
                  >LinkedIn</span
                >
                <span class="mt-1 block text-[13px] text-smoke">{tr('contact.linkedinHint')}</span>
              </span>
              <span class="text-stone" aria-hidden="true">-&gt;</span>
            </a>
          </li>
          <li class="border-b border-rule">
            <a
              href={site.social.github}
              class="group flex items-center justify-between py-4"
              rel="me noopener"
            >
              <span>
                <span class="block text-[15px] font-bold text-ink group-hover:text-link"
                  >GitHub</span
                >
                <span class="mt-1 block text-[13px] text-smoke">{tr('contact.githubHint')}</span>
              </span>
              <span class="text-stone" aria-hidden="true">-&gt;</span>
            </a>
          </li>
        </ul>

        <div>
          <p class="label">{tr('contact.responseTitle')}</p>
          <p class="mt-3 text-[14px] leading-[1.6] text-steel">{tr('contact.responseBody')}</p>
        </div>

        <p class="text-[13px] text-steel">{tr('contact.location')}</p>
      </aside>
    </div>
  </Section>
</Base>
