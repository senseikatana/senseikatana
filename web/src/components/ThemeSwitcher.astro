---
// Lumen theme family selector + light/dark toggle.
import { Select, ThemeToggle } from '@santi020k/lumen-astro';
import { getLocale, useTranslations } from '../i18n';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));

const themes = [
  { value: 'lumen', label: 'Lumen' },
  { value: 'studio', label: 'Studio' },
  { value: 'paper', label: 'Paper' },
];
---

<div class="flex items-center gap-2">
  <Select
    id="theme-family"
    options={themes}
    value="lumen"
    visualSize="sm"
    aria-label={tr('theme.title')}
  />
  <ThemeToggle controlled data-theme-mode aria-label="Switch to dark mode" />
</div>
