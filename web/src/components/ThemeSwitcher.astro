---
// Segmented light / dark control. Any number of instances stay in sync.
---

<div
  class="theme-switch inline-flex border border-rule text-[12px]"
  role="group"
  aria-label="Color theme"
>
  {
    ['light', 'dark'].map((t) => (
      <button
        type="button"
        data-set-theme={t}
        class="flex items-center gap-1.5 px-2.5 py-1 text-smoke"
      >
        <span
          class:list={['size-[7px] border border-current', t === 'dark' && 'bg-current']}
          aria-hidden="true"
        />
        {t}
      </button>
    ))
  }
</div>

<style>
  :global(:root:not([data-theme='dark'])) [data-set-theme='light'],
  :global(:root[data-theme='dark']) [data-set-theme='dark'] {
    background: var(--ink);
    color: var(--canvas);
    font-weight: 700;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const theme = button.dataset.setTheme!;
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* storage may be blocked; the in-memory theme still applies */
      }
    });
  }
</script>
