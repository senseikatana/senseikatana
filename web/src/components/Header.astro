---
import { site } from '../config/site';
import { getLocale, useTranslations } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

const path = Astro.url.pathname;
const tr = useTranslations(getLocale(path, Astro.currentLocale));

const navKeys: Record<string, string> = {
  '/': 'home',
  '/services': 'services',
  '/projects': 'works',
  '/about': 'about',
  '/posts': 'blog',
  '/en/docs/': 'docs',
  '/contact': 'contact',
};

const labelFor = (href: string) => tr(`nav.${navKeys[href] ?? 'home'}`);
---

<!-- Fixed header: sticky once the announcement bar scrolls away; data-scrolled toggles the blurred state -->
<header class="site-header sticky top-0 z-50 border-b border-rule bg-canvas">
  <nav
    class="frame flex items-center gap-8 h-16 px-6 max-md:h-14 max-md:px-5"
    aria-label={tr('a11y.mainNav')}
  >
    <Logo />
    <ul class="hidden md:flex gap-5 text-[14px] lg:gap-7">
      {
        site.nav.map((link) => (
          <li>
            {'children' in link && link.children ? (
              <details class="relative" data-nav-dropdown>
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-1 hover:text-ink [&::-webkit-details-marker]:hidden',
                    path.startsWith(link.href) ? 'text-ink' : 'text-steel',
                  ]}
                >
                  {labelFor(link.href)}
                  <span class="text-stone" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <ul class="absolute left-0 top-[calc(100%+16px)] z-[60] min-w-[232px] border border-ink bg-canvas p-1">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-3 py-2 text-[13px] text-steel hover:bg-tint hover:text-ink"
                      >
                        {'labelKey' in child ? tr(child.labelKey) : child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={link.href}
                class:list={[
                  'hover:text-ink',
                  path.startsWith(link.href) ? 'text-ink' : 'text-steel',
                ]}
              >
                {labelFor(link.href)}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-3 lg:gap-5">
      <div class="hidden md:block"><ThemeSwitcher /></div>
      <LanguageSwitcher />
      <a href={site.cta.href} class="btn btn-primary btn-s hidden md:inline-flex">{tr('nav.cta')}</a
      >
      <button
        type="button"
        class="md:hidden text-[13px] text-ink"
        data-menu-open
        aria-haspopup="dialog">{tr('a11y.menu')}</button
      >
    </div>
  </nav>
</header>

<!-- Mobile menu: full-screen dialog, 100dvh, Esc closes, body scroll locked -->
<dialog
  class="mobile-menu m-0 h-dvh max-h-none w-screen max-w-none bg-canvas text-steel p-0"
  aria-label={tr('a11y.menuLabel')}
>
  <div class="flex flex-col h-full">
    <div class="flex items-center h-14 px-5 border-b border-rule">
      <Logo />
      <button type="button" class="ml-auto text-[13px] text-ink" data-menu-close
        >{tr('a11y.close')}</button
      >
    </div>
    <ul class="px-5 pt-3">
      {
        site.menu.map((link, index) => (
          <li>
            <a href={link.href} class="flex items-center gap-3.5 py-4 border-b border-rule">
              <span class="text-[12px] text-smoke">{String(index + 1).padStart(2, '0')}</span>
              <span class="text-[28px] font-bold tracking-[-0.03em] text-ink">
                {labelFor(link.href)}
              </span>
              <span class="ml-auto text-stone" aria-hidden="true">
                -&gt;
              </span>
            </a>
            {'children' in link && link.children && (
              <ul class="pb-2">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="flex items-center gap-3 py-2.5 pl-8 border-b border-rule text-[15px] text-steel"
                    >
                      <span class="text-stone" aria-hidden="true">
                        -&gt;
                      </span>
                      {'labelKey' in child ? tr(child.labelKey) : child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <div class="mt-auto px-5 pt-5 pb-7 border-t border-rule flex flex-col gap-4">
      <div class="flex items-center">
        <span class="label">{tr('theme.title')}</span><span class="ml-auto"><ThemeSwitcher /></span>
      </div>
      <a href={site.cta.href} class="btn btn-primary w-full">{tr('nav.cta')} -&gt;</a>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--canvas) 82%, transparent);
    backdrop-filter: blur(16px);
    border-bottom-color: var(--ink);
  }
  .site-header[data-scrolled] nav {
    height: 56px;
  }
  :global(html:has(dialog.mobile-menu[open])) {
    overflow: hidden;
  }
  .mobile-menu::backdrop {
    background: transparent;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 48);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const menu = document.querySelector<HTMLDialogElement>('dialog.mobile-menu')!;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));

  const navDropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]');
  for (const element of navDropdowns) {
    element.addEventListener('toggle', () => {
      if (!element.open) return;
      for (const other of navDropdowns) if (other !== element) other.open = false;
    });
    element.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        element.open = false;
      });
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const element of navDropdowns) {
      if (element.open && !element.contains(target)) element.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const element of navDropdowns) element.open = false;
  });
</script>
