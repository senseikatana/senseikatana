---
import { defaultLocale, isLocale, localeLabels, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n';

const pathname = Astro.url.pathname;
const segment = pathname.split('/')[1] ?? '';
const current: Locale = isLocale(Astro.currentLocale ?? '')
  ? (Astro.currentLocale as Locale)
  : isLocale(segment)
    ? segment
    : defaultLocale;
const tr = useTranslations(current);
const bare = pathname.replace(/^\/(ca|en)(?=\/|$)/, '') || '/';
const hrefFor = (locale: Locale) =>
  locale === defaultLocale ? bare : `/${locale}${bare === '/' ? '' : bare}`;
const options = locales.map((locale) => ({
  locale,
  label: localeLabels[locale],
  href: hrefFor(locale),
  active: locale === current,
}));
---

<details class="lang-switch relative shrink-0" data-lang-switch>
  <summary
    class="flex items-center gap-1.5 border border-rule px-2.5 py-1.5 text-[12px] font-bold text-ink"
    aria-label={tr('lang.title')}
  >
    {current.toUpperCase()}
    <span class="text-stone" aria-hidden="true">▾</span>
  </summary>
  <ul class="absolute right-0 z-[60] mt-2 min-w-[172px] border border-ink bg-canvas p-1">
    {
      options.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.locale}
            lang={option.locale}
            aria-current={option.active ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-4 px-2.5 py-2 text-[13px]',
              option.active
                ? 'bg-ink font-bold text-canvas'
                : 'text-steel hover:bg-tint hover:text-ink',
            ]}
          >
            <span>{option.label}</span>
            <span class="text-[11px] uppercase tracking-[0.08em]">{option.locale}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch > summary {
    list-style: none;
    cursor: pointer;
  }
  .lang-switch > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  const switches = document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch]');

  for (const element of switches) {
    element.addEventListener('toggle', () => {
      if (!element.open) return;
      for (const other of switches) {
        if (other !== element) other.open = false;
      }
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const element of switches) {
      if (element.open && !element.contains(target)) element.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const element of switches) element.open = false;
  });
</script>
