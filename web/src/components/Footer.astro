---
import { site } from '../config/site';
import { getLocale, useTranslations } from '../i18n';
import Logo from './Logo.astro';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));

const navKeys: Record<string, string> = {
  '/': 'home',
  '/services': 'services',
  '/projects': 'works',
  '/about': 'about',
  '/posts': 'blog',
  '/en/docs/': 'docs',
  '/contact': 'contact',
};

const labelFor = (href: string, fallback: string) => {
  const key = navKeys[href];
  return key ? tr(`nav.${key}`) : fallback;
};
---

<footer class="border-t border-rule">
  <div class="frame px-6 pt-16 pb-10 max-md:px-5 max-md:pt-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-10 gap-y-10">
      <div class="col-span-2">
        <Logo />
        <p class="mt-4 text-[13px] text-smoke max-w-[34ch] leading-[1.5]">
          {tr('footer.summary')}
        </p>
        <p class="mt-5 text-[13px] text-steel">{site.location}</p>
      </div>
      {
        site.footer.map((column, index) => (
          <div>
            <p class="label">{tr(index === 0 ? 'footer.navTitle' : 'footer.contactTitle')}</p>
            <ul class="mt-4 space-y-3 text-[13px]">
              {column.links.map(([label, href]) => (
                <li>
                  <a
                    href={href}
                    class="text-steel hover:text-ink"
                    rel={href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    {labelFor(href, label)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p
      class="mt-14 pt-5 border-t border-rule text-[12px] text-smoke flex flex-wrap justify-between gap-3"
    >
      <span>&copy; {new Date().getFullYear()} {site.legalName}</span>
      <span>{tr('footer.builtWith')}</span>
    </p>
  </div>
</footer>
