---
import { site } from '../config/site';
import { getLocale, useTranslations } from '../i18n';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
---

<a
  href="/"
  class="text-ink font-bold text-[17px] tracking-[-0.02em] shrink-0 max-md:text-[16px]"
  aria-label={`${site.name} — ${tr('nav.home')}`}
>
  {site.name.toLowerCase()}<span class="text-cta">_</span>
</a>
