---
import { site } from '../config/site';
import { getLocale, useTranslations } from '../i18n';
import Section from './Section.astro';

interface Props {
  title?: string;
  lede?: string;
}

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
const { title = tr('home.ctaTitle'), lede = tr('home.ctaBody') } = Astro.props;
---

<Section
  mode="invert"
  inner="px-6 py-32 max-md:px-5 max-md:py-24 text-center overflow-hidden"
  label={tr('nav.contact')}
>
  <div class="grid-bg" style="--gx:50%;--gy:45%" aria-hidden="true"></div>
  <div class="relative">
    <p class="label"><b>[10]</b> {tr('nav.cta').toLowerCase()}</p>
    <h2 class="mt-5 text-[clamp(40px,5.4vw,68px)] leading-none font-bold tracking-[-0.05em]">
      {title}
    </h2>
    <p class="mt-5 text-[16px] text-steel max-md:text-[14px] max-w-[52ch] mx-auto">{lede}</p>
    <div
      class="mt-9 flex flex-wrap justify-center items-center gap-x-7 gap-y-4 max-md:flex-col max-md:items-stretch"
    >
      <a href={site.cta.href} class="btn btn-primary">{tr('nav.cta')} -&gt;</a>
      <a href={site.secondary.href} class="link text-[15px]">{tr('home.worksCta')} -&gt;</a>
    </div>
  </div>
</Section>
