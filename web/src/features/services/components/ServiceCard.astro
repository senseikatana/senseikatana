---
import { getLocale, useTranslations } from '../../../i18n';
import { contentSlug } from '../../../lib/content';
import type { Service } from '../queries';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
---

<article class="flex flex-col p-5 border-r border-b border-rule">
  <p class="label">[{String(service.data.order).padStart(2, '0')}]</p>
  <h3
    class="mt-3 text-[18px] font-bold tracking-[-0.02em]"
    transition:name={`service-title-${contentSlug(service.id)}`}
  >
    <a href={`/services/${contentSlug(service.id)}`} class="hover:text-link">{service.data.title}</a
    >
  </h3>
  <p class="mt-2 text-[14px] leading-[1.55] text-steel flex-1">{service.data.description}</p>
  <a href={`/services/${contentSlug(service.id)}`} class="link inline-block mt-4 text-[13px]"
    >{tr('services.viewScope')} -&gt;</a
  >
</article>
