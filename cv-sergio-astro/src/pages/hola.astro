---
import { profile, sections, siteNav } from '../data/cv';

const title = `Hola — ${profile.name}`;
const description = `CV digital de ${profile.name}: perfil, experiencia, formación y descarga del PDF.`;
---
<!doctype html>
<html lang="es-ES">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#11151c" />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://senseikatana.com/hola/" />
  <meta property="og:image" content="https://senseikatana.com/cv/sergio-jurado.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style is:global>
    :root {
      /* Paleta Senseikatana v3.0.0 (OKLCH) */
      --rose-300: oklch(0.78 0.13 17); --rose-400: oklch(0.70 0.19 17);
      --rose-500: oklch(0.63 0.23 17); --rose-600: oklch(0.55 0.22 17);
      --rose-900: oklch(0.32 0.11 17);
      --teal-400: oklch(0.55 0.05 185); --teal-500: oklch(0.45 0.06 185);
      --teal-700: oklch(0.32 0.05 185); --teal-800: oklch(0.25 0.04 185);
      --teal-900: oklch(0.18 0.03 185);
      --sky-300: oklch(0.80 0.10 225); --sky-400: oklch(0.74 0.12 225);
      --emerald-400: oklch(0.74 0.16 162);
      --dark-600: oklch(0.25 0.02 260); --dark-700: oklch(0.20 0.02 260);
      --dark-800: oklch(0.15 0.02 260); --dark-900: oklch(0.10 0.02 260);
      --dark-950: oklch(0.06 0.01 260);
      --white-50: oklch(0.99 0.002 260); --white-100: oklch(0.97 0.003 260);
      --white-200: oklch(0.94 0.004 260); --white-300: oklch(0.90 0.005 260);
      --white-400: oklch(0.85 0.005 260); --white-500: oklch(0.78 0.005 260);
      --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --font-mono: ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, monospace;
    }
    * { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--dark-800); color: var(--white-200);
      font-family: var(--font-sans); line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    :focus-visible { outline: 2px solid var(--sky-400); outline-offset: 2px; border-radius: 4px; }
    .container { width: 100%; max-width: 80rem; margin: 0 auto; padding: 0 1rem; }
    .narrow { max-width: 48rem; margin: 0 auto; }
    @media (min-width: 640px) { .container { padding: 0 1.5rem; } }
    @media (min-width: 1024px) { .container { padding: 0 2rem; } }
    .icon { width: 1rem; height: 1rem; flex-shrink: 0; }
  </style>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="i-user" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></g></symbol>
    <symbol id="i-briefcase" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></g></symbol>
    <symbol id="i-graduation-cap" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0zM22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></g></symbol>
    <symbol id="i-sparkles" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4m2-2h-4"/><circle cx="4" cy="20" r="2"/></g></symbol>
    <symbol id="i-info" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></g></symbol>
    <symbol id="i-map-pin" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/></g></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect width="20" height="16" x="2" y="4" rx="2"/></g></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 15V3m9 12v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10l5 5l5-5"/></g></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 6L9 17l-5-5"/></g></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676a.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></g></symbol>
    <symbol id="i-wrench" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></g></symbol>
    <symbol id="i-languages" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m5 8l6 6m-7 0l6-6l2-3M2 5h12M7 2h1m14 20l-5-10-5 10m2-4h6"/></g></symbol>
    <symbol id="i-circle-check" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m16 9l-5.5 5.5L8 12"/></g></symbol>
    <symbol id="i-linkedin" viewBox="0 0 24 24"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065a2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></symbol>
  </svg>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">SJ</a>
      <nav class="site-nav" aria-label="Navegación principal">
        {siteNav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="header-social" aria-label="LinkedIn">
        <svg class="icon"><use href="#i-linkedin" /></svg>
      </a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-url">senseikatana.com/hola</p>
          <h1 class="hero-title">Hola, soy {profile.name}</h1>
          <p class="hero-role">{profile.title}</p>
          <p class="hero-desc">
            Esta página es la versión digital de mi CV: el mismo contenido que el PDF,
            más cómodo de leer en el móvil o en el navegador.
          </p>

          <div class="hero-contact">
            <span class="hero-contact-item">
              <svg class="icon contact-icon"><use href="#i-map-pin" /></svg>{profile.location}
            </span>
            <a href={`tel:${profile.phone.replace(/\s/g, '')}`} class="hero-contact-item link">
              <svg class="icon contact-icon"><use href="#i-phone" /></svg>{profile.phone}
            </a>
            <a href={`mailto:${profile.email}`} class="hero-contact-item link">
              <svg class="icon contact-icon"><use href="#i-mail" /></svg>{profile.email}
            </a>
            <a href={profile.linkedin} target="_blank" rel="noopener" class="hero-contact-item link">
              <svg class="icon contact-icon"><use href="#i-linkedin" /></svg>LinkedIn
            </a>
          </div>

          {profile.note && <p class="hero-note">{profile.note}</p>}

          <div class="hero-actions">
            <a href={profile.pdfUrl} download="CV_sergio-jurado.pdf" class="btn btn-primary btn-lg">
              <svg class="icon icon-lg"><use href="#i-download" /></svg>Descargar PDF
            </a>
            <a href="#perfil" class="btn btn-outline btn-lg">Leer en la web</a>
          </div>
        </div>

        <div class="hero-photo-wrap">
          <img
            src="/cv/sergio-jurado.jpg"
            alt={`Retrato de ${profile.name}`}
            width="1154"
            height="1732"
            fetchpriority="high"
            class="hero-photo"
          />
        </div>
      </div>
    </section>

    <nav class="section-nav" aria-label="Secciones del CV">
      <div class="container section-nav-inner">
        {sections.map((section) => (
          <a href={`#${section.id}`} class="section-chip">
            <span class="section-label">{section.label}</span>
            <svg class="icon section-icon"><use href={`#i-${section.icon}`} /></svg>
            {section.title}
          </a>
        ))}
      </div>
    </nav>

    <section id="perfil" class="block block-a">
      <div class="container narrow">
        <h2 class="block-title">
          <svg class="icon icon-xl accent-rose"><use href="#i-user" /></svg>
          Perfil profesional
        </h2>
        <p class="lead">{profile.summary}</p>
      </div>
    </section>

    <section id="experiencia" class="block block-b">
      <div class="container narrow">
        <h2 class="block-title">
          <svg class="icon icon-xl accent-rose"><use href="#i-briefcase" /></svg>
          Experiencia profesional
        </h2>
        <p class="block-sub">Mismos puestos que en el PDF, con el detalle de cada rol.</p>

        <div class="timeline">
          {profile.experience.map((exp) => (
            <article class="timeline-item">
              <span class="timeline-dot" />
              <div class="entry-head">
                <h3 class="entry-role">{exp.role}</h3>
                <span class="entry-period">{exp.period}</span>
              </div>
              <p class="entry-company">{exp.company}</p>
              <p class="entry-desc">{exp.description}</p>
              <ul class="entry-list">
                {exp.highlights.map((item) => (
                  <li>
                    <svg class="icon accent-teal mt"><use href="#i-check" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="formacion" class="block block-a">
      <div class="container narrow">
        <h2 class="block-title">
          <svg class="icon icon-xl accent-rose"><use href="#i-graduation-cap" /></svg>
          Formación académica
        </h2>

        <div class="card-list">
          {profile.education.map((edu) => (
            <div class="card">
              <div class="entry-head">
                <h3 class="card-title">{edu.degree}</h3>
                <span class="card-period">{edu.period}</span>
              </div>
              <p class="entry-company">{edu.institution}</p>
              {edu.note && <p class="card-note">{edu.note}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="block block-b">
      <div class="container narrow">
        <h2 class="block-title">
          <svg class="icon icon-xl accent-rose"><use href="#i-sparkles" /></svg>
          Competencias
        </h2>

        <div class="skills-grid">
          <div>
            <h3 class="skills-head">Soft skills</h3>
            <ul class="skills-list">
              {profile.softSkills.map((skill) => (
                <li>
                  <svg class="icon accent-rose mt"><use href="#i-heart" /></svg>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="skills-head">Hard skills</h3>
            <ul class="skills-list">
              {profile.hardSkills.map((skill) => (
                <li>
                  <svg class="icon accent-sky mt"><use href="#i-wrench" /></svg>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <h3 class="skills-head lang-head">
          <svg class="icon accent-sky"><use href="#i-languages" /></svg>
          Idiomas
        </h3>
        <div class="lang-chips">
          {profile.languages.map((language) => (
            <div class="lang-chip">
              <span class="lang-name">{language.name}</span>
              <span class="lang-level"> · {language.level}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="extra" class="block block-a">
      <div class="container narrow">
        <h2 class="block-title">
          <svg class="icon icon-xl accent-rose"><use href="#i-info" /></svg>
          Información adicional
        </h2>
        <ul class="extra-list">
          {profile.additional.map((item) => (
            <li>
              <svg class="icon accent-emerald mt-lg"><use href="#i-circle-check" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="cta">
          <p class="cta-text">¿Prefieres el documento clásico? Descarga el PDF o escríbeme directamente.</p>
          <div class="cta-actions">
            <a href={profile.pdfUrl} download="CV_sergio-jurado.pdf" class="btn btn-primary btn-lg">
              <svg class="icon icon-lg"><use href="#i-download" /></svg>Descargar PDF
            </a>
            <a href={`mailto:${profile.email}`} class="btn btn-outline-dark btn-lg">Enviar email</a>
            <a href="/resume/es/" class="btn btn-ghost btn-lg">Ver CV completo</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-text">© {new Date().getFullYear()} {profile.name}</span>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="footer-social" aria-label="LinkedIn">
        <svg class="icon"><use href="#i-linkedin" /></svg>
      </a>
    </div>
  </footer>
</body>
</html>

<style>
  /* ─── Header ─── */
  .site-header {
    position: sticky; top: 0; z-index: 50; height: 4rem;
    background: color-mix(in oklab, var(--dark-900) 80%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in oklab, var(--dark-800) 60%, transparent);
  }
  .header-inner { display: flex; align-items: center; gap: 1.5rem; height: 4rem; }
  .logo { font-weight: 700; font-size: 1.25rem; letter-spacing: -0.025em; color: var(--white-50); }
  .site-nav { display: none; gap: 1.5rem; flex: 1; }
  .site-nav a { font-size: 0.875rem; color: var(--white-300); transition: color .15s; }
  .site-nav a:hover { color: var(--white-100); }
  .header-social {
    margin-left: auto; display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; color: var(--white-300);
    transition: color .15s, background-color .15s;
  }
  .header-social:hover { color: var(--white-50); background: var(--dark-800); }
  .header-social .icon { width: 1.125rem; height: 1.125rem; }
  @media (min-width: 768px) { .site-nav { display: flex; } }

  /* ─── Hero ─── */
  .hero { position: relative; overflow: hidden; padding: 5rem 0; }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom right, var(--dark-900), var(--dark-800), var(--dark-950));
  }
  .hero::after {
    content: ''; position: absolute; inset: 0; opacity: 0.25;
    background:
      radial-gradient(ellipse at bottom left, var(--rose-900) 0%, transparent 45%),
      radial-gradient(ellipse at top right, var(--teal-900) 0%, transparent 40%);
  }
  .hero-inner {
    position: relative; display: flex; flex-direction: column; gap: 2.5rem;
    align-items: flex-start;
  }
  .hero-url { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.025em; color: color-mix(in oklab, var(--sky-300) 90%, transparent); margin-bottom: 1rem; }
  .hero-title { font-size: 2.25rem; font-weight: 700; letter-spacing: -0.025em; color: var(--white-50); margin-bottom: 1rem; }
  .hero-role { font-size: 1.125rem; color: var(--sky-300); margin-bottom: 1rem; }
  .hero-desc { color: var(--white-400); max-width: 42rem; line-height: 1.625; margin-bottom: 2rem; }
  .hero-contact { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.875rem; color: var(--white-400); margin-bottom: 2.5rem; }
  .hero-contact-item { display: flex; align-items: center; gap: 0.375rem; }
  .hero-contact-item.link { transition: color .15s; }
  .hero-contact-item.link:hover { color: var(--white-100); }
  .contact-icon { color: var(--teal-400); }
  .hero-note { font-size: 0.875rem; color: var(--white-500); margin-bottom: 2rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-photo-wrap { flex-shrink: 0; }
  .hero-photo {
    width: 12rem; height: 16rem; object-fit: cover; border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--teal-800) 40%, transparent);
    box-shadow: 0 25px 50px -12px color-mix(in oklab, var(--teal-900) 20%, transparent);
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 3.75rem; }
    .hero-role { font-size: 1.25rem; }
    .hero-photo { width: 14rem; height: 18rem; }
  }
  @media (min-width: 1024px) {
    .hero { padding: 7rem 0; }
    .hero-inner { flex-direction: row; gap: 4rem; }
    .hero-copy { flex: 1; max-width: 42rem; }
  }

  /* ─── Botones ─── */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    font-size: 0.875rem; font-weight: 500; padding: 0.625rem 1rem;
    border-radius: 0.5rem; border: 1px solid transparent; cursor: pointer;
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .btn-lg { padding: 0.625rem 2rem; font-size: 1rem; }
  .icon-lg { width: 1.125rem; height: 1.125rem; }
  .btn-primary { background: var(--rose-500); color: #fff; }
  .btn-primary:hover { background: var(--rose-600); }
  .btn-outline { border-color: color-mix(in oklab, var(--white-200) 20%, transparent); color: var(--white-200); }
  .btn-outline:hover { background: color-mix(in oklab, var(--white-50) 5%, transparent); }
  .btn-outline-dark { border-color: var(--dark-600); color: var(--white-300); }
  .btn-outline-dark:hover { background: var(--dark-800); }
  .btn-ghost { color: var(--sky-400); }
  .btn-ghost:hover { color: var(--sky-300); }

  /* ─── Nav de secciones ─── */
  .section-nav {
    position: sticky; top: 4rem; z-index: 40; padding: 0.75rem 0;
    background: color-mix(in oklab, var(--dark-950) 90%, transparent);
    backdrop-filter: blur(12px);
    border-top: 1px solid color-mix(in oklab, var(--dark-800) 60%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--dark-800) 60%, transparent);
  }
  .section-nav-inner { display: flex; flex-wrap: nowrap; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; scrollbar-width: thin; }
  .section-chip {
    display: inline-flex; flex-shrink: 0; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.875rem; color: var(--white-300);
    border: 1px solid color-mix(in oklab, var(--dark-700) 50%, transparent);
    background: color-mix(in oklab, var(--dark-900) 70%, transparent);
    transition: border-color .15s, color .15s;
  }
  .section-chip:hover { border-color: color-mix(in oklab, var(--teal-700) 50%, transparent); color: var(--sky-300); }
  .section-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--rose-400); }
