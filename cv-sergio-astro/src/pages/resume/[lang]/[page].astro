---
import ResumeLayout from '../../../layouts/ResumeLayout.astro';
import {
  meta,
  ui,
  experience,
  education,
  shopItems,
  profiles,
  LANGS,
  PAGES,
  PROFILE_IDS,
  ROUTE_IDS,
  type RouteId,
} from '../../../data/resume';

/**
 * `getStaticPaths()` corre en un scope aislado: no puede leer variables del
 * frontmatter, pero sí los imports a nivel de módulo. Por eso `LANGS` y
 * `ROUTE_IDS` viven en `data/resume.ts` en vez de redeclararse acá.
 */
export function getStaticPaths() {
  return LANGS.flatMap((lang) => ROUTE_IDS.map((page) => ({ params: { lang, page } })));
}

const isPage = (v: string): v is (typeof PAGES)[number] =>
  (PAGES as readonly string[]).includes(v);
const isProfileId = (v: string): v is (typeof PROFILE_IDS)[number] =>
  (PROFILE_IDS as readonly string[]).includes(v);

const { lang, page } = Astro.params as { lang: (typeof LANGS)[number]; page: RouteId };
const t = ui[lang];
const base = `/resume/${lang}/`;
const profile = isProfileId(page) ? profiles[page][lang] : null;
const pageTitle = profile ? profile.title : isPage(page) ? t[page] : page;
const sortedExperience = [...experience[lang]].sort((a, b) => b.dates.localeCompare(a.dates, 'es'));
---
<ResumeLayout title={pageTitle} lang={lang}>

  {page === 'about' && (
    <>
      <h1>{t.aboutHeading}</h1>
      <p class="muted">{meta.name} · {t.location} · {t.license}</p>
      <p><span class="pill">{t.teaCert}</span></p>

      {t.bio.map((paragraph) => <p>{paragraph}</p>)}

      <h2>{t.skillsHardTitle}</h2>
      <div>{t.skillsHard.map((skill) => <span class="pill">{skill}</span>)}</div>

      <h3 class="sub-heading">{t.skillsSoftTitle}</h3>
      <div>{t.skillsSoft.map((skill) => <span class="pill">{skill}</span>)}</div>

      <h2>{t.languagesTitle}</h2>
      <div>{t.languages.map((language) => <span class="pill">{language}</span>)}</div>

      <h2>{t.recentExp}</h2>
      {sortedExperience.map((entry) => (
        <article class="entry">
          <h3>{entry.role}</h3>
          <p class="muted">{entry.company} · {entry.dates}</p>
          <ul>{entry.tasks.map((task) => <li>{task}</li>)}</ul>
        </article>
      ))}

      <h2>{t.educationTitle}</h2>
      <ul>
        {education[lang].map((entry) => (
          <li>
            <strong>{entry.t}</strong>
            <span class="muted"> · {entry.p} · {entry.d}</span>
          </li>
        ))}
      </ul>

      <h2>{t.availability}</h2>
      <p><span class="pill">{t.availability}</span> <span class="pill">{t.license}</span></p>

      <p class="cta-row">
        <a href={`${base}contact/`} class="btn">{t.contact}</a>
      </p>
    </>
  )}

  {page === 'services' && (
    <>
      <h1>{t.services}</h1>
      <p class="muted">{t.whatIDo}</p>
      <div class="card-grid services-grid">
        {t.servicesList.map((service) => (
          <article class="card">
            <h3>{service.t}</h3>
            <p>{service.d}</p>
          </article>
        ))}
      </div>
      <hr />
      <p><a href={`${base}contact/`}>{t.contact}</a></p>
    </>
  )}

  {page === 'contact' && (
    <>
      <h1>{t.contact}</h1>
      <p>{t.contactIntro}</p>

      <ul class="contact-list">
        <li>
          <span class="muted">Email</span>
          <a href={`mailto:${meta.email}`}>{meta.email}</a>
        </li>
        <li>
          <span class="muted">{t.contactPhone}</span>
          <a href={`tel:${meta.phone.replace(/\s/g, '')}`}>{meta.phone}</a>
        </li>
        <li>
          <span class="muted">LinkedIn</span>
          <a href={meta.linkedin} target="_blank" rel="noopener noreferrer">{t.contactProfile}</a>
        </li>
        <li>
          <span class="muted">GitHub</span>
          <a href={meta.github} target="_blank" rel="noopener noreferrer">{t.contactRepos}</a>
        </li>
      </ul>

      <form id="contact-form" class="contact-form" novalidate>
        <div class="field">
          <label for="cf-name">{t.formName}</label>
          <input id="cf-name" name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cf-email">{t.formEmail}</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="cf-message">{t.formMsg}</label>
          <textarea id="cf-message" name="mensaje" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn">{t.send}</button>
        <p class="form-error" role="alert" hidden></p>
        <p class="muted form-hint">{t.formHint}</p>
      </form>

      {/**
        Va dentro del branch de `contact` a propósito: `is:inline` lo emite tal
        cual en cada página donde aparece, así que fuera de acá el email y el
        subject se inlineaban en las 21 rutas `[page]` sin que exista un form.
      */}
      <script is:inline define:vars={{ recipient: meta.email, subject: t.formSubject, errorText: t.formInvalid }}>
        const form = document.getElementById('contact-form');
        if (form instanceof HTMLFormElement) {
          const error = document.querySelector('.form-error');
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!form.reportValidity()) {
              if (error) {
                error.textContent = errorText;
                error.hidden = false;
              }
              form.querySelector(':invalid')?.focus();
              return;
            }
            if (error) error.hidden = true;
            const data = new FormData(form);
            const body = [
              `${data.get('nombre')}`,
              `${data.get('email')}`,
              '',
              `${data.get('mensaje')}`,
            ].join('\n');
            window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          });
        }
      </script>
    </>
  )}

  {page === 'shop' && (
    <>
      <h1>{t.shopTitle}</h1>
      <p>{t.shopIntro}</p>
      <div class="card-grid shop-grid">
        {shopItems[lang].map((item) => (
          <article class="card">
            <div class="img-placeholder" aria-hidden="true"></div>
            <h3 class="shop-name">{item.name}</h3>
            <p class="muted shop-condition">{item.condition}</p>
            <p class="shop-price">{item.price}</p>
            <a
              href={`mailto:${meta.email}?subject=${encodeURIComponent(`${t.shopSubject}: ${item.name} (${item.price})`)}`}
              aria-label={`${t.contact}: ${item.name} — ${item.price}`}
            >
              {t.contact} →
            </a>
          </article>
        ))}
      </div>
      <hr />
      <p class="muted">{t.pickup}</p>
    </>
  )}

  {profile && (
    <>
      <header class="profile-head">
        <h1>{profile.title}</h1>
        <p class="roles">{profile.role}</p>
        <p class="muted">
          <span class="pill">{t.location}</span>
          <span class="pill">{t.teaCert}</span>
        </p>
      </header>

      <hr />

      <h2>{t.aboutHeading}</h2>
      <p>{profile.about}</p>
      <p class="muted profile-desc">{profile.desc}</p>

      <hr />

      <h2>{t.skillsTitle}</h2>
      <div>{profile.skills.map((skill) => <span class="pill">{skill}</span>)}</div>

      <hr />

      <h2>{t.recentExp}</h2>
      {profile.exp.map((entry) => (
        <article class="entry">
          <h3>{entry.t}</h3>
          <p class="muted">{entry.c} · {entry.d}</p>
          <ul>{entry.b.map((bullet) => <li>{bullet}</li>)}</ul>
        </article>
      ))}

      <hr />

      <p class="cta-row">
        <a href={base} class="btn">← {t.home}</a>
        <a href={`mailto:${meta.email}`} class="btn btn-secondary">{t.contact}</a>
      </p>
    </>
  )}
</ResumeLayout>

<style>
  .entry { margin-bottom: 1.5rem; }
  .sub-heading { margin-top: 1.5rem; }
  .cta-row { margin-top: 2rem; }
  .cta-row .btn + .btn { margin-left: 0.5rem; }
  .btn-secondary { background: var(--muted); }
  .services-grid, .shop-grid { margin-top: 2rem; }
  .contact-list { list-style: none; padding: 0; margin: 2rem 0; }
  .contact-list li {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1rem;
    padding: 0.6rem 0; border-bottom: 1px dashed var(--border); margin-bottom: 0;
  }
  .contact-list .muted { min-width: 6rem; font-family: var(--font-mono); font-size: 0.85rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; max-width: 34rem; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field label { font-size: 0.9rem; color: var(--muted); }
  .field input, .field textarea {
    padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--card); color: var(--fg); font-family: inherit; font-size: 1rem;
  }
  .field input:focus-visible, .field textarea:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 1px;
  }
  .contact-form .btn { align-self: flex-start; }
  .form-hint { font-size: 0.85rem; margin: 0; }
  .form-error {
    margin: 0; padding: 0.6rem 0.8rem; border-radius: 8px; font-size: 0.9rem;
    background: color-mix(in oklab, #dc2626 14%, var(--card));
    border: 1px solid color-mix(in oklab, #dc2626 45%, transparent);
    color: var(--fg);
  }
  .profile-head { text-align: center; padding: 1.5rem 0; }
  .roles { font-family: var(--font-mono); color: var(--accent); font-size: 1rem; margin: 0.5rem 0; }
  .profile-desc { font-style: italic; }
  .img-placeholder {
    width: 100%; height: 160px; border-radius: 8px;
    background: linear-gradient(135deg, var(--card) 0%, var(--border) 100%);
  }
  .shop-name { margin-top: 1rem; }
  .shop-condition { font-size: 0.9rem; }
  .shop-price { font-size: 1.4rem; font-weight: 700; color: var(--accent); }
</style>