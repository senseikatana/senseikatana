{
	"name": "katanakit-js",
	"version": "7.1.4",
	"description": "KatanaKit — a sharp, framework-agnostic TypeScript service toolkit organized with hexagonal architecture.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"kai": "dist/adapters/cli/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./adapters/cli": {
			"types": "./dist/adapters/cli/index.d.ts",
			"import": "./dist/adapters/cli/index.js",
			"default": "./dist/adapters/cli/index.js"
		},
		"./adapters/express": {
			"types": "./dist/adapters/express/index.d.ts",
			"import": "./dist/adapters/express/index.js",
			"default": "./dist/adapters/express/index.js"
		},
		"./adapters/hono": {
			"types": "./dist/adapters/hono/index.d.ts",
