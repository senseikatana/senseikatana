		"./adapters/nestjs": {
			"types": "./dist/adapters/nestjs/index.d.ts",
			"import": "./dist/adapters/nestjs/index.js",
			"default": "./dist/adapters/nestjs/index.js"
		},
		"./prisma": {
			"types": "./dist/prisma/index.d.ts",
			"import": "./dist/prisma/index.js",
			"default": "./dist/prisma/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.js",
			"default": "./dist/schemas/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./dist/styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"scss"
	],
	"sass": "scss/main.scss",
	"style": "./dist/styles.css",
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"workspaces": [
		"packages/ui"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "husky",

		"clean": "node scripts/clean.mjs",

		"lint": "eslint ./src packages/ui/src",
		"lint:fix": "eslint --fix ./src packages/ui/src",
		"typecheck": "tsc6 --noEmit && tsc6 -p packages/ui/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"check": "bun run lint && bun run typecheck && bun run test",
		"test:all": "bun run check && bun run test:e2e",

		"build:ui": "bun run --filter @katanakit/ui build",
		"build:lib": "tsc6 -p tsconfig.json && tsc-alias -p tsconfig.json && bun run build:ui && node -e \"require('node:fs').copyFileSync('packages/ui/dist/styles.css','dist/styles.css')\" && node scripts/copy-prisma-artifacts.mjs && node scripts/generate-release-notes.mjs --sync-versions && node scripts/verify-package.mjs",
		"build:examples": "tsc6 -p tsconfig.examples.json && tsc6 -p tsconfig.examples.solid.json",
		"build": "bun run clean && bun run build:lib && bun run build:examples",

		"docs": "node scripts/docs.mjs build",
		"docs:preview": "node scripts/docs.mjs preview",
		"docs:clean": "node scripts/docs.mjs clean",

		"deploy": "bun run check && bun run build && node scripts/docs.mjs deploy --skip-ui",
		"deploy:gh": "bun run check && bun run build && node scripts/docs.mjs gh --skip-ui",
		"release": "bun run check && bun run build && node scripts/generate-release-notes.mjs \"v$(node -p \"require('./package.json').version\")\" --write && node scripts/npm-publish.mjs",

		"dev": "bunx lint-staged && concurrently -n docs,api -c magenta,cyan --kill-others \"bun run docs:dev\" \"bun run api:dev\"",
		"docs:dev": "node scripts/docs.mjs dev",
		"api:dev": "tsx src/adapters/express/main.ts",
		"bun:dev": "bun run src/adapters/bun/main.ts"
	},
	"lint-staged": {
		"**/*.{ts,tsx}": "eslint --fix --quiet"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/senseikatana/katanakit-js.git"
	},
	"keywords": [
		"api",
		"fetch",
		"http-client",
		"url-builder",
		"typescript",
		"hexagonal-architecture",
		"astro",
		"express",
		"nuxt",
		"vue",
		"react",
		"solid",
		"svelte",
		"angular",
		"singleton",
		"observer",
		"factory",
		"notion",
		"wordpress"
	],
	"author": "senseikatana - Sergio Jurado",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/senseikatana/katanakit-js/issues"
	},
	"unpkg": "./dist/index.js",
	"jsdelivr": "./dist/index.js",
	"dependencies": {
		"@js-temporal/polyfill": "0.5.1",
		"@tanstack/query-core": "5.104.1",
		"zod": "^4.6.5"
	},
