# ==============================================================================
#  KatanaKit — local environment template
#
#  Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
#  This package is a LIBRARY: it ships no runtime env contract of its own.
#  Consumers bring their own. The variables below only drive this repo's own
#  tooling, split by which script layer reads them:
#
#    develop  — bun run dev | dev:server | dev:bun
#    build    — bun run build | build:ui | docs
#    deploy   — bun run deploy
#    publish  — bun run release | publish   (npm auth comes from your login)
# ==============================================================================

# ------------------------------------------------------------------------------
#  DEVELOP — local dev servers
# ------------------------------------------------------------------------------

# Express dev server bind address (bun run dev:server).
PORT="3000"
HOST="localhost"
# Port for the VitePress docs dev server (bun run dev / docs:dev).
VITE_DEV_PORT="5173"

# ------------------------------------------------------------------------------
#  DEVELOP / BUILD — database
# ------------------------------------------------------------------------------
# Read by prisma.config.ts, so `prisma contract emit`, `prisma db *` and
# `bun run server:dev` all need it. Required for any Prisma command.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ------------------------------------------------------------------------------
#  DEVELOP — assistant providers (optional, only for the examples)
# ------------------------------------------------------------------------------

# AI assistant (DashScope / OpenAI-compatible).
DASHSCOPE_API_KEY="sk-"

# ------------------------------------------------------------------------------
#  DEPLOY — Cloudflare Pages (bun run deploy only)
# ------------------------------------------------------------------------------
# Dashboard > Profile > API Tokens > Create Token.
# Leave EMPTY locally to fall back to the `bunx wrangler login` OAuth session —
# a non-empty placeholder overrides the session and breaks wrangler.
CLOUDFLARE_API_TOKEN=""
# Cloudflare dashboard > Account Home > Account ID.
CLOUDFLARE_ACCOUNT_ID=""