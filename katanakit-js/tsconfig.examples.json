{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": ".",
		"jsx": "react-jsx",
		"paths": {
			"katanakit-js": ["./dist/index.d.ts"],
			"katanakit-js/*": ["./dist/*"]
		}
	},
	"include": [
		"examples/query/vanilla.ts",
		"examples/query/react.tsx",
		"examples/query/angular.ts",
		"examples/seed/seed-data.ts"
	],
	"exclude": ["node_modules", "dist"]
}
