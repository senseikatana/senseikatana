{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "senseikatana-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "HUEPLAY", "service": "hueplay" },
    { "binding": "NUMPLATE", "service": "plate-numerology" },
    { "binding": "WEB", "service": "senseikatana-web" },
  ],
  "vars": {
    "DOCS_ORIGIN": "https://senseikatana-docs.pages.dev",
  },
  "routes": [
    { "pattern": "senseikatana.com", "custom_domain": true },
    { "pattern": "www.senseikatana.com", "custom_domain": true },
    { "pattern": "docs.senseikatana.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
