{
  "$schema": "https://unpkg.com/wrangler@4.162.0/config-schema.json",
  "name": "katanakit-docs-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "routes": [
    // samuraicoder.dev — docs/library paths only.
    { "pattern": "samuraicoder.dev/docs", "zone_name": "samuraicoder.dev" },
    { "pattern": "samuraicoder.dev/docs/*", "zone_name": "samuraicoder.dev" },
    { "pattern": "samuraicoder.dev/en/docs", "zone_name": "samuraicoder.dev" },
    { "pattern": "samuraicoder.dev/en/docs/*", "zone_name": "samuraicoder.dev" },
  ],
}
