{
  "name": "senseikatana",
  "version": "3.0.0",
  "description": "Monorepo: KatanaKit library, personal website, and docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "katana-kit",
    "katana-kit/packages/ui",
    "apps/web",
    "workers/router"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "esbuild"
  ],
  "scripts": {
    "check": "prettier --check README.md CHANGELOG.md AGENTS.md package.json && bun run --filter katanakit-js check",
    "format": "prettier --write README.md CHANGELOG.md AGENTS.md package.json",
    "prepare": "husky",
    "docs": "bun run --filter katanakit-js docs",
    "docs:dev": "bun run --filter katanakit-js docs:dev",
    "web:dev": "bun run --filter @senseikatana/web dev",
    "web:build": "bun run --filter @senseikatana/web build",
    "router:dev": "bun run --cwd workers/router dev",
    "router:deploy": "bun run --cwd workers/router deploy"
  },
  "author": "Sergio Jurado",
  "license": "MIT",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "axios": "^1.20.0",
    "rimraf": "^6.1.3"
  },
  "lint-staged": {
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
