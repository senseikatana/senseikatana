{
  "name": "senseikatana",
  "version": "3.1.4",
  "description": "Personal site and digital CV — senseikatana.com",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "esbuild"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --filter @senseikatana/web dev",
    "build": "bun run --filter @senseikatana/web build",
    "preview": "bun run --filter @senseikatana/web preview",
    "check": "prettier --check . && eslint . && bun run --filter @senseikatana/web check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "bun run build && bunx wrangler@4.145.0 pages deploy web/dist --project-name senseikatana-web --branch main",
    "deploy:preview": "bun run build && bunx wrangler@4.145.0 pages deploy web/dist --project-name senseikatana-web --branch dev",
    "tunnel": "cloudflared tunnel --url http://localhost:4321 --no-autoupdate",
    "docs:dev": "node scripts/docs.mjs dev",
    "docs:build": "node scripts/docs.mjs build",
    "docs:preview": "node scripts/docs.mjs preview",
    "docs:deploy": "node scripts/docs.mjs deploy",
    "docs:clean": "node scripts/docs.mjs clean"
  },
  "author": "Sergio Jurado",
  "license": "MIT",
  "lint-staged": {
    "*.{json,jsonc,md,mdx,yml,yaml,css,scss,html,astro}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.71.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "vitepress": "^1.6.4",
    "vitest": "5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {}
}
