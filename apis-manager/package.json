{
  "name": "apify-manager",
  "version": "1.0.0",
  "description": "A lightweight, framework-agnostic API URL builder and fetch utility. Designed to work seamlessly across React, Next.js, Astro, Svelte, Remix, and vanilla JavaScript/TypeScript environments.",
  "main": "index.js",
  "scripts": {
    "build": "bun run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senseikatana/apify-manager.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/senseikatana/apify-manager/issues"
  },
  "homepage": "https://github.com/senseikatana/apify-manager#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": "babel-jest"
    }
  }
}
