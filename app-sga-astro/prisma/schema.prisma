// Prisma schema — SGA ESINSA (source of truth: PostgreSQL / Neon).
// Phase 1 of the hexagonal refactor: real repositories replace the InsForge stub.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user")
}

model InventoryItem {
  id        String   @id @default(uuid())
  nutcode   String   @unique // NUT0004001
  desc      String
  type      String // Espárragos | Tuercas | Tornillos sin fin | Juntas | Cajas/Embalaje
  stock     Int      @default(0)
  minStock  Int      @default(0)
  loc       String // rack code, e.g. A-01-03
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      InventoryLog[]

  @@map("inventory_item")
}

model Order {
  id        String   @id @default(uuid())
  number    String   @unique // #0001
  customer  String
  status    String // paid | pending | refunded
  amount    Float
  date      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order")
}

model Customer {
  id        String   @id @default(uuid())
  code      String   @unique // CLI00001
  name      String
  email     String   @unique
  company   String?
  phone     String?
  plan      String // Team | Starter | Enterprise
  status    String // active | trial | past-due
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

model Location {
  id         String  @id @default(uuid())
  rackCode   String  @unique // A-01-03
  aisle      String
  rackNumber Int
  level      Int // validated 0..6 at the domain layer
  position   Int
  nutcode    String? @unique // product currently stored here

  @@map("location")
}

model InventoryLog {
  id              String         @id @default(uuid())
  inventoryItemId String         @map("inventory_item_id")
  quantityChange  Int // positive = IN, negative = OUT
  reason          String // RECEPTION | PICKING | TRANSFER | ADJUSTMENT
  createdAt       DateTime       @default(now())
  item            InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@map("inventory_log")
}
