---
import type { ThroughJourney } from "../lib/search";
import type { RoutesResults } from "../config/i18n/types";
import RouteAccordion from "./RouteAccordion.astro";

interface Props {
	journey: ThroughJourney;
	t: RoutesResults;
	index?: number;
}

const { journey, t, index = 0 } = Astro.props;
---

<details
	class="group bg-surface-tint/5 rounded-xl border border-deep-navy/20 ambient-shadow overflow-hidden"
	open={index === 0}
>
	<summary class="cursor-pointer list-none flex items-center justify-between gap-3 p-5">
		<div class="flex flex-col gap-1">
			<span class="font-headline-md text-headline-md text-deep-navy flex items-center gap-2 flex-wrap">
				<span class="material-symbols-outlined text-coastal-teal">route</span>
				<span class="font-label-md text-label-md bg-deep-navy text-on-primary px-2 py-0.5 rounded">{t.throughBadge}</span>
				{journey.firstLeg.name} → {journey.secondLeg.name}
			</span>
			<span class="font-body-md text-body-md text-on-surface-variant flex items-center gap-2">
				<span class="material-symbols-outlined text-[18px] text-energetic-orange">flag</span>
				{t.throughAtLabel}
				<span class="text-deep-navy font-semibold">{journey.connectionStop}</span>
			</span>
		</div>
		<span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform">expand_more</span>
	</summary>
	<div class="px-5 pb-6 flex flex-col gap-4 border-t border-outline-variant/20 pt-5">
		<RouteAccordion line={journey.firstLeg} t={t} index={-1} legLabel={`${t.legLabel} 1`} />
		<RouteAccordion line={journey.secondLeg} t={t} index={-1} legLabel={`${t.legLabel} 2`} />
		<div class="overflow-x-auto">
			<table class="w-full text-left">
				<thead>
					<tr class="font-label-md text-label-md text-outline uppercase tracking-wide">
						<th class="py-2 pr-3">{t.throughOriginHeader}</th>
						<th class="py-2 pr-3">{t.throughConnectionHeader}</th>
						<th class="py-2 pr-3">{t.throughWaitHeader}</th>
						<th class="py-2 pr-3">{t.throughDepartHeader}</th>
						<th class="py-2">{t.throughDestinationHeader}</th>
					</tr>
				</thead>
				<tbody>
					{journey.pairs.map((pair) => (
						<tr class="font-body-md text-body-md text-on-surface border-t border-outline-variant/20">
							<td class="py-2 pr-3 text-deep-navy font-semibold">{pair.firstDeparture}</td>
							<td class="py-2 pr-3">{pair.arriveAtConnection}</td>
							<td class="py-2 pr-3 text-on-surface-variant">{pair.wait}</td>
							<td class="py-2 pr-3 text-deep-navy font-semibold">{pair.secondDeparture}</td>
							<td class="py-2">{pair.arriveAtDestination}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</details>
