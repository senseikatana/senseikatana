---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.locations.title,
	description: dict.locations.hero.subtitle,
	lang: locale,
	ogTitle: dict.locations.hero.title,
	ogDescription: dict.locations.hero.subtitle,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background text-on-surface font-body-md antialiased";
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<!-- TopNavBar -->
<nav class="bg-surface dark:bg-inverse-surface w-full sticky top-0 z-50 transition-shadow duration-300 shadow-ambient">
<div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto h-20">
<div class="flex items-center gap-2">
<a class="font-headline-md text-headline-md font-bold text-deep-navy dark:text-primary-fixed-dim" href="#">
                    Empresa Plana
                </a>
</div>
<div class="hidden md:flex items-center gap-8 h-full">
<a class="font-button text-button text-on-surface-variant dark:text-outline-variant hover:text-coastal-teal transition-colors duration-200 h-full flex items-center" href="#">
                    Services
                </a>
<a class="font-button text-button text-deep-navy dark:text-primary-fixed-dim border-b-2 border-deep-navy dark:border-primary-fixed-dim pb-1 h-full flex items-center mt-1" href="#">
                    Locations
