---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.locationsMobile.title,
	description: dict.locations.hero.subtitle,
	lang: locale,
	ogTitle: dict.locationsMobile.hero.title,
	ogDescription: dict.locations.hero.subtitle,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background text-on-background antialiased min-h-screen pb-24 md:pb-0";
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<!-- TopAppBar -->
<header class="bg-primary dark:bg-primary fixed top-0 w-full z-50 flat no shadows flex justify-between items-center px-margin-mobile w-full h-16 transition-opacity duration-200">
<button aria-label="Menu" class="text-on-primary hover:opacity-80 p-2 -ml-2">
<span class="material-symbols-outlined" data-icon="menu">menu</span>
</button>
<h1 class="font-headline-md text-headline-md font-bold text-on-primary absolute left-1/2 -translate-x-1/2">Dónde Estamos</h1>
<button aria-label="Account" class="text-on-primary hover:opacity-80 p-2 -mr-2">
<span class="material-symbols-outlined" data-icon="account_circle">account_circle</span>
</button>
</header>
<main class="pt-16">
<!-- Hero Section -->
<section class="relative h-64 w-full">
<div class="absolute inset-0 bg-cover bg-center w-full h-full" data-alt="A modern, high-quality photograph of a sleek, white and navy blue corporate bus driving along a scenic coastal Mediterranean road. The bright sunlight reflects off the pristine surface of the bus, conveying a sense of efficient mobility and high-end transport services. The background features a sparkling blue sea and clear sky, aligning with the brand's optimistic and reliable identity." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCrunoZWu70PkX0ZEQAznLTUzEydDuz53hC3fVI-gjANCfq5EmMQIZpgzJbDf_Qc31dJYtZaWZpJLjkuB9JuBCjz9Yx2bIHBe2H3B4qGILw0LwAuXP_s0GeHwLv8SatMc-ZYXFlk8Ivrz52PVji2xDDMhDIhcc35aO3X-U50_xsU0nVwLhbTqekdSgrUgCeq-IXa9rTbNw6bHD0TDATVbhGzX3e---JkTzZKO50TUX32pdzUZCvAKJo')"></div>
<div class="absolute inset-0 bg-black/40"></div>
<div class="absolute inset-0 flex items-center justify-center">
<h2 class="font-headline-lg-mobile text-headline-lg-mobile text-white text-center tracking-wide uppercase shadow-sm">Dónde Estamos</h2>
</div>
</section>
<div class="px-margin-mobile md:px-margin-desktop py-stack-lg max-w-container-max mx-auto space-y-stack-lg">
<!-- Central Office Bento Grid -->
<section class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
<div class="bg-surface-container-lowest rounded-xl p-stack-md shadow-[0px_4px_20px_rgba(1,57,144,0.08)] border border-outline-variant flex flex-col justify-center h-full">
<div class="flex items-center space-x-3 mb-4">
<div class="w-10 h-10 rounded-full bg-primary-container/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined" data-icon="location_on">location_on</span>
</div>
<h3 class="font-headline-md text-headline-md text-primary">Central Office</h3>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-2">
                        Polígono Industrial Riu Clar<br/>
                        Calle del Plomo, s/n<br/>
                        43006 Tarragona
                    </p>
<div class="mt-auto pt-4 flex items-center space-x-2 text-on-tertiary-container">
<span class="material-symbols-outlined text-xl" data-icon="phone">phone</span>
<a class="font-button text-button hover:underline" href="tel:+34977553680">+34 977 55 36 80</a>
</div>
</div>
<div class="h-64 md:h-full rounded-xl overflow-hidden shadow-[0px_4px_20px_rgba(1,57,144,0.08)] relative">
<img class="w-full h-full object-cover" data-alt="A clean, modern digital map interface centered on Tarragona, Spain, highlighting the Polígono Industrial Riu Clar area. The map uses a sophisticated color palette of subtle grays and light blues, matching the corporate navy aesthetic. A prominent, energetic orange location pin marks the central office, ensuring high contrast and immediate visual recognition within a high-end UI layout." data-location="Tarragona, Spain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBkvCy_fG1Agvc9a-HmhJMyti7EmOWfOud621xD8RvnZPPour8jecF7PJTAnSivXEU50UPYcEBmY-xSILLdlBWCKX7EWS472UNWTNdg_GudyCLmSkpRjsP_X8K0Eiwaj9h0Yxc-GRWvHMVgdHj_gtgLoG8eyh69Buw43E5ALs3hdFMY4gdyvbZtPbGu-ve1cIrihJjRhkIlA94QJ8JhQqtKvsfgYCZjUltMRfQkZ9avxBU4wv0FsUZx"/>
</div>
</section>
<!-- Delegations Section -->
<section>
<div class="flex items-center mb-stack-md space-x-2">
<span class="material-symbols-outlined text-primary" data-icon="domain">domain</span>
<h3 class="font-headline-md text-headline-md text-primary">Delegaciones</h3>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-stack-md">
<!-- Base Card 1 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base Tarragona</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Pol. Ind. Riu Clar</p>
</div>
<!-- Base Card 2 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base Reus</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Av. de Salou, s/n</p>
</div>
<!-- Base Card 3 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base Garraf</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Pol. Ind. Vilanova i la Geltrú</p>
</div>
<!-- Base Card 4 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base Calafell</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Ctra. C-31, km 136</p>
</div>
<!-- Base Card 5 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base Barcelona</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Zona Franca</p>
</div>
<!-- Base Card 6 -->
<div class="bg-surface-container-lowest p-stack-md rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(1,57,144,0.08)] hover:shadow-lg transition-shadow duration-200 group cursor-pointer">
<h4 class="font-label-md text-label-md text-primary mb-1 group-hover:text-on-tertiary-container transition-colors">Base L'Hospitalet de l'Infant</h4>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">Pol. Ind. Les Tàpies</p>
</div>
</div>
</section>
</div>
</main>
<!-- BottomNavBar -->
<nav class="md:hidden bg-surface dark:bg-surface-container fixed bottom-0 w-full z-50 rounded-t-xl bg-surface dark:bg-surface-container shadow-[0px_-4px_20px_rgba(1,57,144,0.08)] flex justify-around items-center h-16 w-full px-margin-mobile pb-safe">
<!-- Tab 1: Routes (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-container-high scale-95 transition-transform duration-150 w-16 h-full" href="#">
<span class="material-symbols-outlined mb-1" data-icon="directions_bus">directions_bus</span>
<span class="font-label-md text-label-md text-[10px]">Routes</span>
</a>
<!-- Tab 2: Tickets (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-container-high scale-95 transition-transform duration-150 w-16 h-full" href="#">
<span class="material-symbols-outlined mb-1" data-icon="confirmation_number">confirmation_number</span>
<span class="font-label-md text-label-md text-[10px]">Tickets</span>
</a>
<!-- Tab 3: Locations (Active) -->
<a class="flex flex-col items-center justify-center bg-tertiary-container text-on-tertiary-container rounded-full px-4 py-1 hover:bg-surface-container-high scale-95 transition-transform duration-150 h-12 mt-1" href="#">
<span class="material-symbols-outlined mb-0.5" data-icon="map" data-weight="fill" style="font-variation-settings: 'FILL' 1;">map</span>
<span class="font-label-md text-label-md text-[10px] font-bold">Locations</span>
</a>
<!-- Tab 4: Services (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-container-high scale-95 transition-transform duration-150 w-16 h-full" href="#">
<span class="material-symbols-outlined mb-1" data-icon="stars">stars</span>
<span class="font-label-md text-label-md text-[10px]">Services</span>
</a>
</nav>
</BaseLayout>
