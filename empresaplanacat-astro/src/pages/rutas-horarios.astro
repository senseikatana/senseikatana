---
import BaseLayout from '../layouts/BaseLayout.astro';
import TownSelect from '../components/TownSelect.astro';
import RouteAccordion from '../components/RouteAccordion.astro';
import TransferAccordion from '../components/TransferAccordion.astro';
import ThroughAccordion from '../components/ThroughAccordion.astro';
import { TIME_RANGES } from '../data/towns';
import { searchRoutes } from '../lib/search';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);

interface SearchState {
	origin: string;
	destination: string;
	date: string;
	time: string;
	searchType: 'direct' | 'transfer';
}

let state: SearchState = {
	origin: 'Tarragona',
	destination: 'Salou',
	date: '',
	time: '',
	searchType: 'direct',
};
let searched = false;
let error: string | null = null;
let results: Awaited<ReturnType<typeof searchRoutes>> | null = null;

if (Astro.request.method === 'POST') {
	searched = true;
	const form = await Astro.request.clone().formData();
	state = {
		origin: String(form.get('origin') ?? '').trim(),
		destination: String(form.get('destination') ?? '').trim(),
		date: String(form.get('date') ?? '').trim(),
		time: String(form.get('time') ?? '').trim(),
		searchType: String(form.get('search_type')) === 'transfer' ? 'transfer' : 'direct',
	};
	if (!state.origin || !state.destination) {
		error = dict.routes.results.missingSelection;
	} else {
		try {
			results = await searchRoutes(state.origin, state.destination, state.searchType === 'transfer');
		} catch {
			error = dict.routes.results.databaseError;
		}
	}
}

const formAction = `${Astro.url.pathname}${Astro.url.search}#results`;

const siteInfo = getSiteInfo({
	title: dict.routes.title,
	description: dict.routes.hero.subtitle,
	lang: locale,
	ogTitle: dict.routes.hero.title,
	ogDescription: dict.routes.hero.subtitle,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen";
const t = dict.routes.results;
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<!-- TopNavBar Component -->
<header class="bg-surface dark:bg-inverse-surface w-full sticky top-0 z-50 transition-colors duration-300 shadow-sm">
<!-- Utility Bar -->
<div class="w-full bg-deep-navy text-on-primary py-2 px-margin-desktop text-sm flex justify-end items-center gap-4 hidden md:flex">
<span class="font-label-md text-label-md flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">call</span> +34 977 553 680
            </span>
<div class="flex gap-2 font-label-md text-label-md">
<a class="hover:text-energetic-orange transition-colors" href="#">CA</a> |
                <a class="text-energetic-orange font-bold" href="#">ES</a> |
                <a class="hover:text-energetic-orange transition-colors" href="#">EN</a>
</div>
</div>
<nav class="flex justify-between items-center w-full px-margin-desktop max-w-container-max mx-auto h-20">
<!-- Brand -->
<a class="font-headline-md text-headline-md font-bold text-deep-navy dark:text-primary-fixed-dim flex items-center gap-2" href="#">
                Empresa Plana
            </a>
<!-- Navigation Links (Desktop) -->
<ul class="hidden md:flex items-center gap-8 h-full">
<li class="h-full flex items-center">
<a class="font-button text-button text-on-surface-variant dark:text-outline-variant hover:text-coastal-teal transition-colors duration-200" href="#">
                        Services
                    </a>
</li>
<li class="h-full flex items-center">
<a class="font-button text-button text-on-surface-variant dark:text-outline-variant hover:text-coastal-teal transition-colors duration-200" href="#">
                        Locations
                    </a>
</li>
<!-- Active Item -->
<li class="h-full flex items-center">
<a class="font-button text-button text-deep-navy dark:text-primary-fixed-dim border-b-2 border-deep-navy dark:border-primary-fixed-dim pb-1 opacity-80 transition-opacity" href="#">
                        Downloads
                    </a>
</li>
</ul>
<!-- Actions -->
<div class="hidden md:flex items-center gap-4">
<a class="font-button text-button text-deep-navy hover:text-coastal-teal transition-colors duration-200" href="#">
                    Contact
                </a>
<button class="bg-energetic-orange text-on-primary font-button text-button px-6 py-3 rounded hover:bg-opacity-90 transition-all shadow-sm">
                    BOOK NOW
                </button>
</div>
<!-- Mobile Menu Toggle -->
<button class="md:hidden text-deep-navy p-2">
<span class="material-symbols-outlined">menu</span>
</button>
</nav>
</header>
<main class="flex-grow">
<!-- Hero & Search Widget Section -->
<section class="relative w-full pt-12 pb-24 md:pt-20 md:pb-32 px-margin-mobile md:px-margin-desktop flex flex-col items-center justify-center min-h-[500px]">
<!-- Background Image -->
<div class="absolute inset-0 z-0">
<div class="w-full h-full bg-cover bg-center" data-alt="A breathtaking panoramic view of a modern luxury coach bus driving along a sun-drenched Mediterranean coastal highway. The deep blue sea stretches out to the horizon under a clear, bright sky. The lighting is warm and inviting, evoking a sense of safe, comfortable, and scenic travel. The scene perfectly balances the corporate reliability of the bus with the beautiful, relaxing vacation destination vibe." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDCT_DQ6eMxgF0yrSOajgjIT1aocZsjEi7wlpLIbaUbLo3Oux_VBSyoMPtR6KZW2G_6x-y7PLBKB5zbHe--97W2rCcZ0t6wduzIaWNvs-pT8x65mppwMQzKjYNde5vFUXI8u_8tJH_cGQCcqZjYsBD1TvQEMJQjY8kwXCsqiTs1FC5Y92j8WqLolI-sTHX-uiqFyYbg_W54ecT8snpGkKtxCBq9tOmaGsZ9ryHtOU4joYjN6Yb-O2li')"></div>
<div class="absolute inset-0 bg-primary-fixed/80 backdrop-blur-sm mix-blend-multiply"></div>
<div class="absolute inset-0 bg-gradient-to-b from-transparent to-background/90"></div>
</div>
<!-- Content -->
<div class="relative z-10 w-full max-w-container-max mx-auto flex flex-col gap-stack-lg items-center">
<div class="text-center max-w-3xl text-on-primary">
<h1 class="font-display-lg text-display-lg md:text-[56px] leading-tight mb-4 drop-shadow-md">Rutas y Horarios</h1>
<p class="font-body-lg text-body-lg text-on-primary/90">Localiza fácilmente los horarios de bus y rutas disponibles para llegar a tu destino en transporte público por la Costa Dorada.</p>
</div>
<!-- Buscador Widget -->
<div class="w-full max-w-5xl glass-panel rounded-xl ambient-shadow p-6 md:p-8 mt-6">
<h2 class="font-headline-md text-headline-md text-deep-navy flex items-center gap-2 mb-6 border-b border-outline-variant/30 pb-4">
<span class="material-symbols-outlined">directions_bus</span>
                        {dict.routes.search.title}
                    </h2>
<form class="flex flex-col gap-6" method="post" action={formAction}>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
<!-- Origin -->
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">{dict.routes.search.originLabel}</label>
<TownSelect name="origin" placeholder={dict.routes.search.originPlaceholder} defaultValue={state.origin} icon="location_on" />
</div>
<!-- Destination -->
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">{dict.routes.search.destinationLabel}</label>
<TownSelect name="destination" placeholder={dict.routes.search.destinationPlaceholder} defaultValue={state.destination} icon="pin_drop" />
</div>
<!-- Date -->
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">{dict.routes.search.dateLabel}</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">calendar_today</span>
<input class="w-full pl-10 pr-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-colors font-body-md text-body-md" type="date" name="date" value={state.date}/>
</div>
</div>
<!-- Time Schedule -->
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">{dict.routes.search.timeLabel}</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">schedule</span>
<select name="time" class="w-full pl-10 pr-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-colors appearance-none font-body-md text-body-md cursor-pointer">
<option value="" selected={!state.time}>{dict.routes.search.anyTime}</option>
{TIME_RANGES.map((range) => (
<option value={range.value} selected={state.time === range.value}>{range.label}</option>
))}
</select>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
</div>
</div>
</div>
<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pt-2 border-t border-outline-variant/30">
<!-- Search Type -->
<div class="flex items-center gap-6">
<label class="flex items-center gap-2 cursor-pointer group">
<input checked={state.searchType === 'direct'} class="w-4 h-4 text-coastal-teal border-outline-variant focus:ring-coastal-teal" name="search_type" type="radio" value="direct"/>
<span class="font-body-md text-body-md text-on-surface-variant group-hover:text-deep-navy transition-colors">{dict.routes.search.direct}</span>
</label>
<label class="flex items-center gap-2 cursor-pointer group">
<input checked={state.searchType === 'transfer'} class="w-4 h-4 text-coastal-teal border-outline-variant focus:ring-coastal-teal" name="search_type" type="radio" value="transfer"/>
<span class="font-body-md text-body-md text-on-surface-variant group-hover:text-deep-navy transition-colors">{dict.routes.search.withTransfers}</span>
</label>
</div>
<!-- Submit -->
<button class="w-full md:w-auto bg-energetic-orange text-on-primary font-button text-button px-8 py-3 rounded hover:bg-opacity-90 transition-all ambient-shadow flex items-center justify-center gap-2 min-h-[48px]" type="submit">
<span class="material-symbols-outlined">search</span>
                                {dict.routes.search.submit}
                            </button>
</div>
</form>
<p class="text-xs text-outline mt-4 italic">{dict.routes.search.disclaimer}</p>
</div>
</div>
</section>
{searched && (
<section id="results" class="w-full py-16 px-margin-mobile md:px-margin-desktop bg-surface-container-lowest border-t border-outline-variant/20">
<div class="max-w-container-max mx-auto">
<h2 class="font-headline-lg text-headline-lg text-deep-navy mb-2">{t.title}</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant mb-8 flex items-center gap-2">
{t.summaryLabel}:
<strong class="text-deep-navy">{state.origin}</strong>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
<strong class="text-deep-navy">{state.destination}</strong>
</p>
{error && (
<div class="bg-error-container text-on-error-container rounded-xl p-5 mb-8 flex items-center gap-3">
<span class="material-symbols-outlined">error</span>
<span class="font-body-md text-body-md">{error}</span>
</div>
)}
{!error && results && results.direct.length === 0 && results.transfers.length === 0 && results.through.length === 0 && (
<div class="bg-surface-container-low rounded-xl p-10 text-center border border-outline-variant/30">
<span class="material-symbols-outlined text-[40px] text-outline">search_off</span>
<h3 class="font-headline-md text-headline-md text-deep-navy mt-3">{t.emptyTitle}</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-2 max-w-xl mx-auto">{t.emptyBody}</p>
<p class="font-body-md text-body-md text-on-surface-variant">{t.emptyHint}</p>
</div>
)}
{!error && results && results.direct.length > 0 && (
<div class="flex flex-col gap-4">
<h3 class="font-headline-md text-headline-md text-deep-navy flex items-center gap-2">
<span class="material-symbols-outlined text-coastal-teal">alt_route</span>
{t.directTitle} ({results.direct.length})
</h3>
{results.direct.map((line, index) => (
<RouteAccordion line={line} t={t} index={index} />
))}
</div>
)}
{!error && results && results.transfers.length > 0 && (
<div class="flex flex-col gap-4 mt-10">
<h3 class="font-headline-md text-headline-md text-deep-navy flex items-center gap-2">
<span class="material-symbols-outlined text-coastal-teal">sync_alt</span>
{t.transfersTitle} ({results.transfers.length})
</h3>
{results.transfers.map((transfer, index) => (
<TransferAccordion transfer={transfer} t={t} index={index} />
))}
</div>
)}
{!error && results && results.through.length > 0 && (
<div class="flex flex-col gap-4 mt-10">
<h3 class="font-headline-md text-headline-md text-deep-navy flex items-center gap-2">
<span class="material-symbols-outlined text-coastal-teal">route</span>
{t.throughTitle} ({results.through.length})
</h3>
{results.through.map((journey, index) => (
<ThroughAccordion journey={journey} t={t} index={index} />
))}
</div>
)}
<p class="text-xs text-outline mt-6 italic">{t.searchingInfo}</p>
</div>
</section>
)}
<!-- Most Searched Lines Section -->
<section class="w-full py-16 px-margin-mobile md:px-margin-desktop bg-surface-gray">
<div class="max-w-container-max mx-auto">
<div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
<div>
