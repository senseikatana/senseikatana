---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';

interface Props {
	entry: CollectionEntry<'docs'>;
	entries: CollectionEntry<'docs'>[];
}

const { entry, entries } = Astro.props;
const sorted = [...entries].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const index = sorted.findIndex((item) => item.id === entry.id);
const prev = sorted[index - 1];
const next = sorted[index + 1];
---

<Layout>
	<div class="mx-auto flex max-w-6xl">
		<aside class="hidden w-60 shrink-0 border-r border-gray-200 p-5 lg:block dark:border-slate-800">
			<a href="/" class="mb-6 flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-white">
				<span class="grid h-7 w-7 place-items-center rounded-lg bg-indigo-600 text-xs font-black text-white">
					W
				</span>
				WarehouseFlow · API
			</a>
			<nav class="space-y-1">
				{
					sorted.map((item) => (
						<a
							href={`/docs/${item.id}`}
							class:list={[
								'block rounded-lg px-3 py-2 text-sm font-medium transition',
								item.id === entry.id
									? 'bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300'
									: 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white',
							]}
						>
							{item.data.title}
						</a>
					))
				}
			</nav>
			<div class="mt-8 space-y-1 border-t border-gray-200 pt-4 dark:border-slate-800">
				<a
					href="http://localhost:8787/api"
					target="_blank"
					class="block rounded-lg px-3 py-2 text-xs font-medium text-gray-500 transition hover:text-gray-900 dark:text-slate-500 dark:hover:text-white"
				>
					Server manifest · :8787/api
				</a>
				<a
					href="/"
					class="block rounded-lg px-3 py-2 text-xs font-medium text-gray-500 transition hover:text-gray-900 dark:text-slate-500 dark:hover:text-white"
				>
					Volver al dashboard
				</a>
			</div>
		</aside>

		<main class="min-w-0 flex-1">
			<header class="flex items-center justify-between border-b border-gray-200 px-5 py-4 dark:border-slate-800">
				<div class="flex items-center gap-3 lg:hidden">
					<a href="/" class="text-xs font-bold text-gray-900 dark:text-white">WarehouseFlow · API</a>
				</div>
				<div class="flex items-center gap-3 lg:ml-auto">
					<a href="/docs" class="text-xs font-medium text-gray-500 transition hover:text-gray-900 dark:text-slate-400 dark:hover:text-white">
						Índice
					</a>
					<a href="/" class="text-xs font-medium text-gray-500 transition hover:text-gray-900 dark:text-slate-400 dark:hover:text-white">
						Dashboard
					</a>
					<button
						id="docs-theme-toggle"
						type="button"
						class="rounded-lg border border-gray-200 px-2.5 py-1.5 text-xs font-bold text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
					>
						Theme
					</button>
				</div>
			</header>

			<article class="docs px-5 py-8 md:px-10">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-white">{entry.data.title}</h1>
				<p class="mt-2 text-gray-500 dark:text-slate-400">{entry.data.description}</p>
				<div class="mt-8">
					<slot />
				</div>

				<nav class="mt-12 flex items-center justify-between gap-4 border-t border-gray-200 pt-6 dark:border-slate-800">
					{
						prev ? (
							<a
								href={`/docs/${prev.id}`}
								class="text-sm font-medium text-gray-600 transition hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-300"
							>
								← {prev.data.title}
							</a>
						) : (
							<span />
						)
					}
					{
						next ? (
							<a
								href={`/docs/${next.id}`}
								class="text-sm font-medium text-gray-600 transition hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-300"
							>
								{next.data.title} →
							</a>
						) : (
							<span />
						)
					}
				</nav>
			</article>
		</main>
	</div>

	<script is:inline>
		(function () {
			var toggle = document.getElementById('docs-theme-toggle');
			if (!toggle) return;
			var root = document.documentElement;
			toggle.addEventListener('click', function () {
				var dark = root.classList.toggle('dark');
				localStorage.setItem('whm.theme', dark ? 'dark' : 'light');
			});
		})();
	</script>
</Layout>

<style>
	.docs :global(*) {
		box-sizing: border-box;
	}
	.docs :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--tw-gray-900, #111827);
	}
	.dark .docs :global(h2) {
		color: #fff;
	}
	.docs :global(h3) {
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: #111827;
	}
	.dark .docs :global(h3) {
		color: #fff;
	}
	.docs :global(p) {
		margin-top: 0.75rem;
		line-height: 1.7;
		font-size: 0.925rem;
		color: #374151;
	}
	.dark .docs :global(p) {
		color: #cbd5e1;
	}
	.docs :global(ul),
	.docs :global(ol) {
		margin-top: 0.75rem;
		margin-left: 1.25rem;
		list-style: disc;
	}
	.docs :global(ol) {
		list-style: decimal;
	}
	.docs :global(li) {
		margin-top: 0.35rem;
		font-size: 0.925rem;
		color: #374151;
	}
	.dark .docs :global(li) {
		color: #cbd5e1;
	}
	.docs :global(a) {
		color: #4f46e5;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.dark .docs :global(a) {
		color: #818cf8;
	}
	.docs :global(code) {
		border-radius: 0.375rem;
		background: #f3f4f6;
		padding: 0.15rem 0.4rem;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.85em;
		color: #be123c;
	}
	.dark .docs :global(code) {
		background: #1e293b;
		color: #f472b6;
	}
	.docs :global(pre) {
		overflow-x: auto;
		margin-top: 0.75rem;
		border: 1px solid #e5e7eb;
		border-radius: 0.75rem;
		background: #0f172a;
		padding: 1rem;
	}
	.dark .docs :global(pre) {
		border-color: #1e293b;
	}
	.docs :global(pre code) {
		background: transparent;
		padding: 0;
		font-size: 0.8rem;
		color: #e2e8f0;
	}
	.docs :global(blockquote) {
		margin-top: 0.75rem;
		border-left: 3px solid #c7d2fe;
		padding-left: 1rem;
		font-style: italic;
		color: #6b7280;
	}
	.dark .docs :global(blockquote) {
		border-color: #4338ca;
		color: #94a3b8;
	}
	.docs :global(table) {
		margin-top: 0.75rem;
		width: 100%;
		border-collapse: collapse;
		font-size: 0.85rem;
	}
	.docs :global(th) {
		border-bottom: 2px solid #e5e7eb;
		padding: 0.5rem 0.75rem;
		text-align: left;
		font-weight: 700;
		color: #374151;
	}
	.dark .docs :global(th) {
		border-color: #334155;
		color: #e2e8f0;
	}
	.docs :global(td) {
		border-bottom: 1px solid #f3f4f6;
		padding: 0.5rem 0.75rem;
		color: #374151;
	}
	.dark .docs :global(td) {
		border-color: #1e293b;
		color: #cbd5e1;
	}
</style>
