---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('docs')).sort(
	(a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<Layout>
	<div class="mx-auto max-w-4xl px-5 py-12">
		<header class="flex items-center justify-between">
			<div class="flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-white">
				<span class="grid h-7 w-7 place-items-center rounded-lg bg-indigo-600 text-xs font-black text-white">
					W
				</span>
				WarehouseFlow · API
			</div>
			<a
				href="/"
				class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-bold text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
			>
				Dashboard
			</a>
		</header>

		<main class="mt-12">
			<h1 class="text-3xl font-bold text-gray-900 dark:text-white">
				Documentación del Server
			</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-500 dark:text-slate-400">
				Backend de mensajería de WarehouseFlow: REST + SSE sobre Express y SQLite. Encontrá cada
				endpoint, sus parámetros, ejemplos con <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-rose-600 dark:bg-slate-800 dark:text-rose-400">curl</code>
				y las respuestas reales.
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				{entries.map((entry, index) => (
					<a
						href={`/docs/${entry.id}`}
						class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/50"
					>
						<span class="text-xs font-bold text-indigo-500">0{index + 1}</span>
						<h2 class="mt-2 text-base font-bold text-gray-900 group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-300">
							{entry.data.title}
						</h2>
						<p class="mt-1.5 text-sm leading-relaxed text-gray-500 dark:text-slate-400">
							{entry.data.description}
						</p>
					</a>
				))}
			</div>

			<div class="mt-10 rounded-xl border border-gray-200 bg-gray-50/60 p-5 dark:border-slate-800 dark:bg-slate-800/30">
				<h2 class="text-sm font-bold text-gray-900 dark:text-white">Enlaces útiles</h2>
				<ul class="mt-3 space-y-2 text-sm">
					<li>
						<a
							href="http://localhost:8787/api"
							target="_blank"
							class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-300"
						>
							Manifest JSON de endpoints
						</a>
						<span class="ml-2 text-gray-500 dark:text-slate-400">· localhost:8787/api</span>
					</li>
					<li>
						<a
							href="http://localhost:8787/"
							target="_blank"
							class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-300"
						>
							Landing del server
						</a>
						<span class="ml-2 text-gray-500 dark:text-slate-400">· localhost:8787/</span>
					</li>
					<li>
						<a
							href="http://localhost:8787/api/health"
							target="_blank"
							class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-300"
						>
							Health check
						</a>
						<span class="ml-2 text-gray-500 dark:text-slate-400">· localhost:8787/api/health</span>
					</li>
				</ul>
			</div>
		</main>
	</div>
</Layout>
