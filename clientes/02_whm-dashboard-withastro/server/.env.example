# Servidor de mensajería (Express + Drizzle/SQLite)
# Copiá este archivo a server/.env y completá los valores.

# Puerto del API (default: 8787)
PORT=8787

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:4321,http://127.0.0.1:4321

# --- Telegram (BotFather) ---
# 1. Hablá con @BotFather en Telegram y creá un bot con /newbot.
# 2. Copiá el token y pegálo acá.
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
# 1. Creá una app en https://developers.facebook.com
# 2. Agregá el producto WhatsApp y un número de teléfono de prueba.
# 3. Copiá el token de acceso y el Phone Number ID acá.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Token para verificar el webhook (elegilo vos, cualquier string).
WHATSAPP_VERIFY_TOKEN=

# Versión de la Graph API (default: v22.0)
WHATSAPP_VERSION=v22.0

# --- Copiloto KITT (IA) ---
# Proveedor: "openrouter" o "ollama" (local). Default: auto
# (si hay OPENROUTER_API_KEY usa OpenRouter, si no usa Ollama).
KITT_PROVIDER=auto

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo de OpenRouter (multimodal recomendado: google/gemini-2.5-flash)
KITT_MODEL=google/gemini-2.5-flash

# Ollama local: https://ollama.com  (levantá con "ollama serve")
# OLLAMA_MODEL=llama3.2

# Opcional: URL de la base de datos de mensajería. Por defecto usa una SQLite local en server/data/whm.db.
# Para Turso, usá libsql://<db>?authToken=<token>
# LIBSQL_URL=
