---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Crear cuenta - NUM Perfume">
  <section class="min-h-screen flex">
    
    <!-- Left side - Image -->
    <div class="hidden lg:block lg:w-1/2 relative overflow-hidden">
      <img 
        src="https://www.genspark.ai/api/files/s/MmekJO3k?cache_control=3600" 
        alt="NUM Perfume Collection" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-warm-900/40 to-warm-900/20"></div>
      
      <div class="absolute bottom-16 left-12 right-12 z-10">
        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-8">
          <p class="font-serif text-white text-lg italic leading-relaxed">
            "Descubre tu esencia, define tu estilo."
          </p>
          <p class="text-white/60 text-sm mt-3">- NUM Perfume</p>
        </div>
      </div>
    </div>

    <!-- Right side - Form -->
    <div class="w-full lg:w-1/2 flex items-center justify-center px-6 py-20 bg-cream">
      <div class="w-full max-w-md">
        
        <div class="mb-12">
          <a href="/" class="inline-block">
            <span class="font-serif text-3xl tracking-tight text-warm-900">NUM</span>
            <span class="text-[10px] uppercase tracking-[0.3em] text-warm-500 block -mt-1">perfume</span>
          </a>
        </div>
        
        <div class="mb-10">
          <h1 class="font-serif text-3xl md:text-4xl text-warm-900 tracking-tight">
            Crea tu cuenta
          </h1>
          <p class="text-warm-500 mt-2 text-sm">
            Unete y disfruta de ofertas exclusivas y seguimiento de pedidos.
          </p>
        </div>

        <div id="error-message" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>

        <form id="signup-form" class="space-y-6">
          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-warm-600 font-medium mb-2">
              Correo electronico
            </label>
            <input 
              id="email" 
              name="email" 
              type="email" 
              autocomplete="email" 
              required 
              class="w-full px-4 py-3.5 bg-white border border-warm-200 rounded-xl text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all duration-300" 
              placeholder="tu@email.com"
            />
          </div>
          
          <div>
            <label for="password" class="block text-xs uppercase tracking-widest text-warm-600 font-medium mb-2">
              Contrasena
            </label>
            <input 
              id="password" 
              name="password" 
              type="password" 
              autocomplete="new-password" 
              required 
              minlength={6}
              class="w-full px-4 py-3.5 bg-white border border-warm-200 rounded-xl text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all duration-300" 
              placeholder="Minimo 6 caracteres"
            />
          </div>

          <div>
            <label for="confirm-password" class="block text-xs uppercase tracking-widest text-warm-600 font-medium mb-2">
              Confirmar contrasena
            </label>
            <input 
              id="confirm-password" 
              name="confirm-password" 
              type="password" 
              autocomplete="new-password" 
              required 
              minlength={6}
              class="w-full px-4 py-3.5 bg-white border border-warm-200 rounded-xl text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all duration-300" 
              placeholder="Repite tu contrasena"
            />
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-warm-900 text-white py-3.5 rounded-xl text-sm font-medium tracking-wide hover:bg-gold-600 transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-gold-200/30"
          >
            Crear cuenta
          </button>
        </form>

        <p class="text-center text-sm text-warm-500 mt-8">
          Ya tienes cuenta? 
          <a href="/login" class="text-gold-600 hover:text-gold-700 font-medium transition-colors">Iniciar sesion</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { auth, createUserWithEmailAndPassword } from '../lib/firebase';

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  function showError(message: string) {
    errorDiv.textContent = message;
    errorDiv.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');

    if (passwordInput.value !== confirmPasswordInput.value) {
      showError('Las contrasenas no coinciden.');
      return;
    }

    if (passwordInput.value.length < 6) {
      showError('La contrasena debe tener al menos 6 caracteres.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creando cuenta...';

    try {
      await createUserWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
      window.location.href = '/';
    } catch (error: any) {
      const messages: Record<string, string> = {
        'auth/email-already-in-use': 'Ya existe una cuenta con este correo.',
        'auth/invalid-email': 'Correo electronico invalido.',
        'auth/weak-password': 'La contrasena es muy debil.',
      };
      showError(messages[error.code] || 'Error al crear la cuenta. Intenta de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta';
    }
  });
</script>
