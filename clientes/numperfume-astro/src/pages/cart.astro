---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Carrito | NUM Perfume">
  <main class="bg-[#fafafa] min-h-screen">
    <section>
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
        <div class="mx-auto max-w-3xl">
          <header class="text-center mb-12">
            <h1 class="text-3xl md:text-4xl font-serif text-gray-900 mb-4">Tu Carrito</h1>
            <p class="text-gray-500 text-sm">Revisa tu selección antes de finalizar la compra.</p>
          </header>

          <div class="mt-8 bg-white p-6 md:p-8 shadow-sm border border-gray-100">
            <ul class="space-y-6 md:space-y-8">
              <!-- Item 1 -->
              <li class="flex flex-col sm:flex-row items-start sm:items-center gap-4 border-b border-gray-50 pb-6">
                <img 
                  src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&q=80&w=200" 
                  alt="NUM 012" 
                  class="size-24 rounded-none object-cover bg-gray-100"
                />

                <div class="flex-1">
                  <h3 class="text-base font-bold text-gray-900 font-serif tracking-wide">NUM 012</h3>
                  <p class="text-xs text-gray-500 italic font-serif mb-2">Inspiración en Baccarat Rouge 540</p>

                  <dl class="mt-0.5 space-y-1 text-xs text-gray-600">
                    <div>
                      <dt class="inline font-medium">Tamaño:</dt>
                      <dd class="inline">50 ml</dd>
                    </div>
                    <div>
                      <dt class="inline font-medium">Precio:</dt>
                      <dd class="inline">19,95 €</dd>
                    </div>
                  </dl>
                </div>

                <div class="flex items-center justify-between w-full sm:w-auto sm:justify-end gap-4 mt-4 sm:mt-0">
                  <form>
                    <label for="Line1Qty" class="sr-only"> Cantidad </label>
                    <div class="flex items-center border border-gray-200">
                      <button type="button" class="px-3 py-1 text-gray-600 hover:text-black transition">&minus;</button>
                      <input 
                        type="number" 
                        min="1" 
                        value="1" 
                        id="Line1Qty" 
                        class="h-8 w-10 bg-transparent p-0 text-center text-xs text-gray-900 [-moz-appearance:_textfield] focus:outline-none [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none"
                      />
                      <button type="button" class="px-3 py-1 text-gray-600 hover:text-black transition">&plus;</button>
                    </div>
                  </form>

                  <button class="text-gray-400 transition hover:text-red-600" title="Eliminar producto">
                    <span class="sr-only">Eliminar producto</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
                    </svg>
                  </button>
                </div>
              </li>

              <!-- Item 2 -->
              <li class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <img 
                  src="https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&q=80&w=200" 
                  alt="NUM 045" 
                  class="size-24 rounded-none object-cover bg-gray-100"
                />

                <div class="flex-1">
                  <h3 class="text-base font-bold text-gray-900 font-serif tracking-wide">NUM 045</h3>
                  <p class="text-xs text-gray-500 italic font-serif mb-2">Inspiración en Black Opium</p>

                  <dl class="mt-0.5 space-y-1 text-xs text-gray-600">
                    <div>
                      <dt class="inline font-medium">Tamaño:</dt>
                      <dd class="inline">50 ml</dd>
                    </div>
                    <div>
                      <dt class="inline font-medium">Precio:</dt>
                      <dd class="inline">16,95 €</dd>
                    </div>
                  </dl>
                </div>

                <div class="flex items-center justify-between w-full sm:w-auto sm:justify-end gap-4 mt-4 sm:mt-0">
                  <form>
                    <label for="Line2Qty" class="sr-only"> Cantidad </label>
                    <div class="flex items-center border border-gray-200">
                      <button type="button" class="px-3 py-1 text-gray-600 hover:text-black transition">&minus;</button>
                      <input 
                        type="number" 
                        min="1" 
                        value="2" 
                        id="Line2Qty" 
                        class="h-8 w-10 bg-transparent p-0 text-center text-xs text-gray-900 [-moz-appearance:_textfield] focus:outline-none [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none"
                      />
                      <button type="button" class="px-3 py-1 text-gray-600 hover:text-black transition">&plus;</button>
                    </div>
                  </form>

                  <button class="text-gray-400 transition hover:text-red-600" title="Eliminar producto">
                    <span class="sr-only">Eliminar producto</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
                    </svg>
                  </button>
                </div>
              </li>
            </ul>

            <!-- Sección de Resumen y Totales -->
            <div class="mt-8 flex justify-end border-t border-gray-100 pt-8">
              <div class="w-full max-w-md space-y-4">
                <dl class="space-y-2 text-sm text-gray-700">
                  <div class="flex justify-between">
                    <dt>Subtotal</dt>
                    <dd>53,85 €</dd>
                  </div>

                  <div class="flex justify-between">
                    <dt>IVA (21% Incluido)</dt>
                    <dd>9,34 €</dd>
                  </div>

                  <div class="flex justify-between text-[var(--accent)] font-medium">
                    <dt>Descuento Bienvenida</dt>
                    <dd>-5,38 €</dd>
                  </div>

                  <div class="flex justify-between font-bold text-lg text-black border-t border-gray-100 pt-4 mt-2">
                    <dt>Total</dt>
                    <dd>48,47 €</dd>
                  </div>
                </dl>

                <div class="flex justify-end">
                  <span class="inline-flex items-center justify-center rounded-none bg-yellow-50 px-3 py-1 text-[var(--accent)] border border-yellow-100">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ms-1 me-1.5 size-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"></path>
                    </svg>
                    <p class="text-xs whitespace-nowrap font-medium tracking-wide">1 Cupón Aplicado</p>
                  </span>
                </div>

                <div class="flex justify-end mt-6">
                  <a href="/checkout" class="block w-full text-center rounded-none bg-black px-6 py-4 text-sm font-bold uppercase tracking-wider text-white transition hover:bg-[var(--accent)] hover:text-white">
                    Finalizar Compra
                  </a>
                </div>
                
                <div class="text-center mt-4">
                  <a href="/catalogo" class="text-xs text-gray-500 hover:text-black underline transition-colors">o seguir comprando</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
