---
import Layout from '../layouts/Layout.astro';

const features = [
  { 
    title: "Garantia ISO", 
    description: "Certificacion ISO y normativa UE",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
  { 
    title: "Hecho en Espana", 
    description: "Elaborados y envasados en Espana",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`
  },
  { 
    title: "Envio gratis", 
    description: "Pedidos +40 euros a toda Espana",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193l-2.254-2.882A3.375 3.375 0 0014.395 3h-3.27a1.125 1.125 0 00-1.125 1.125v13.5" /></svg>`
  },
  { 
    title: "Pago seguro", 
    description: "Tarjeta o PayPal",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>`
  },
];

const products = [
  { id: 1, name: "Num Oud", tag: "Novedad exclusiva", price: "39,90", img: "https://www.genspark.ai/api/files/s/saXAVkVX?cache_control=3600" },
  { id: 2, name: "Num Pistachio", tag: "Novedad exclusiva", price: "34,90", img: "https://www.genspark.ai/api/files/s/JkUJDbKg?cache_control=3600" },
  { id: 3, name: "Num Bergamot", tag: "Mas vendido", price: "29,90", img: "https://www.genspark.ai/api/files/s/VRHbl52u?cache_control=3600" },
  { id: 4, name: "Num Santal", tag: "Clasico", price: "45,00", img: "https://www.genspark.ai/api/files/s/GNiDiQB3?cache_control=3600" },
];

const reviews = [
  { 
    text: "Un perfume duradero, con una gran estela. Una fragancia de calidad muy recomendada, con personalidad y ultra femenina, para destacar con elegancia.", 
    author: "Maria G.",
    rating: 5
  },
  { 
    text: "Desde que lo oli me enamore, se ha convertido en un basico!! Lo uso tanto yo como mi marido y en los 2 queda maravilloso. Dulce sin ser empalagoso y calido con un toque fresco y juvenil.", 
    author: "Elena R.",
    rating: 5
  },
  { 
    text: "Desde la primera pulverizacion te envuelve un pistacho cremoso y ligeramente tostado, acompanado de avellana y un toque de ron que le da ese matiz licoroso, calido y sofisticado.", 
    author: "Carlos M.",
    rating: 5
  },
  { 
    text: "Excelente perfume para el dia a dia. Increible desde el primer flick. Super bien presentado y entrega en tiempo perfecto.", 
    author: "Laura P.",
    rating: 5
  },
  { 
    text: "Perfumes exquisitos, con aroma unico! Con excelente precio! Ya les he comprado 3 distintos y a cual mas bueno! Repetire!", 
    author: "Andres F.",
    rating: 5
  },
  { 
    text: "Me encanto su fragancia tan intensa, es ideal para que te recuerden por donde vayas... Es excelente y dura todo el dia.", 
    author: "Sofia L.",
    rating: 5
  },
];

const categories = [
  { name: "Femeninos", description: "Florales, afrutados y orientales", count: "12 fragancias" },
  { name: "Masculinos", description: "Amaderados, frescos y especiados", count: "10 fragancias" },
  { name: "Unisex", description: "Sin genero, sin limites", count: "8 fragancias" },
];
---

<Layout title="NUM Perfume - El arte de perfumar">

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-warm-900">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://www.genspark.ai/api/files/s/Td0AR5Yn?cache_control=3600" 
        alt="NUM Perfume" 
        class="w-full h-full object-cover opacity-50"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-warm-900/60 via-warm-900/30 to-warm-900/90"></div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <div class="animate-fade-in">
        <span class="inline-block text-gold-400 text-xs uppercase tracking-[0.4em] font-medium mb-8">
          Descubre tu esencia
        </span>
      </div>
      
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-white tracking-tight leading-[0.95] mb-8 animate-fade-in-up">
        El arte de
        <br/>
        <span class="shimmer-text">cautivar.</span>
      </h1>
      
      <p class="text-warm-300 text-base md:text-lg font-light max-w-xl mx-auto mb-12 leading-relaxed animate-fade-in-up delay-200" style="opacity:0">
        Colecciones exclusivas elaboradas en Espana con pasion, para que encuentres la fragancia que te identifique.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-400" style="opacity:0">
        <a href="#novedades" class="group inline-flex items-center gap-3 bg-gold-500 text-white px-8 py-4 text-sm font-medium tracking-wide rounded-full hover:bg-gold-600 transition-all duration-300 shadow-lg shadow-gold-500/20">
          Descubrir catalogo
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
        </a>
        <a href="/sobre-nosotros" class="inline-flex items-center gap-2 text-warm-300 text-sm font-medium tracking-wide hover:text-white transition-colors duration-300 border-b border-warm-600 pb-1 hover:border-warm-300">
          Nuestra historia
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 animate-float">
      <div class="w-[1px] h-12 bg-gradient-to-b from-transparent via-gold-400 to-transparent"></div>
    </div>
  </section>

  <!-- Trust Bar / Features -->
  <section class="relative bg-white border-b border-warm-200/60">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {features.map((feature) => (
          <div class="flex items-center gap-3 group">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-gold-50 flex items-center justify-center text-gold-600 group-hover:bg-gold-100 transition-colors duration-300">
              <Fragment set:html={feature.icon} />
            </div>
            <div>
              <h3 class="font-medium text-sm text-warm-800">{feature.title}</h3>
              <p class="text-[11px] text-warm-500">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products / Novedades -->
  <section id="novedades" class="py-24 md:py-32 bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4" data-animate>
        <div>
          <span class="text-gold-500 text-xs uppercase tracking-[0.3em] font-medium">Coleccion</span>
          <h2 class="font-serif text-4xl md:text-5xl tracking-tight text-warm-900 mt-3">
            Novedades exclusivas
          </h2>
          <p class="text-warm-500 mt-3 max-w-md">Descubre las ultimas incorporaciones a nuestra coleccion de fragancias.</p>
        </div>
        <a href="#" class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-warm-600 hover:text-gold-600 transition-colors group">
          Ver todo el catalogo
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
        </a>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {products.map((product, idx) => (
          <div class="group cursor-pointer" data-animate style={`animation-delay: ${idx * 0.1}s`}>
            <div class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-warm-100 mb-5">
              <!-- Tag -->
              <span class="absolute top-4 left-4 z-10 bg-white/90 backdrop-blur-sm text-warm-800 px-3 py-1.5 text-[10px] uppercase tracking-widest font-semibold rounded-full shadow-sm">
                {product.tag}
              </span>
              <!-- Image -->
              <img 
                src={product.img} 
                alt={product.name} 
                class="object-cover w-full h-full transition-all duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <!-- Overlay on hover -->
              <div class="absolute inset-0 bg-warm-900/0 group-hover:bg-warm-900/10 transition-all duration-500 flex items-end justify-center pb-6">
                <button class="translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-400 bg-white text-warm-900 px-6 py-2.5 text-xs uppercase tracking-widest font-semibold rounded-full shadow-lg hover:bg-gold-500 hover:text-white">
                  Ver detalle
                </button>
              </div>
            </div>
            <div class="flex items-start justify-between px-1">
              <div>
                <h3 class="font-serif text-lg text-warm-900 group-hover:text-gold-700 transition-colors">{product.name}</h3>
                <p class="text-sm text-warm-500 mt-0.5">{product.price} &euro;</p>
              </div>
              <button class="mt-1 w-9 h-9 rounded-full border border-warm-200 flex items-center justify-center hover:bg-warm-900 hover:text-white hover:border-warm-900 transition-all duration-300 text-warm-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Mobile CTA -->
      <div class="mt-12 text-center md:hidden">
        <a href="#" class="inline-flex items-center gap-2 text-sm font-medium text-warm-600 border-b border-warm-300 pb-1">
          Ver todo el catalogo
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="coleccion" class="py-24 md:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-16" data-animate>
        <span class="text-gold-500 text-xs uppercase tracking-[0.3em] font-medium">Explora</span>
        <h2 class="font-serif text-4xl md:text-5xl tracking-tight text-warm-900 mt-3">Descubre por categoria</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {categories.map((cat, idx) => (
          <a href="#" class="group relative overflow-hidden rounded-2xl bg-warm-50 border border-warm-100 p-10 md:p-12 hover:border-gold-200 hover:bg-gold-50/30 transition-all duration-500" data-animate style={`animation-delay: ${idx * 0.15}s`}>
            <div class="relative z-10">
              <span class="text-[10px] uppercase tracking-[0.2em] text-gold-500 font-medium">{cat.count}</span>
              <h3 class="font-serif text-3xl text-warm-900 mt-2 group-hover:text-gold-700 transition-colors">{cat.name}</h3>
              <p class="text-sm text-warm-500 mt-2">{cat.description}</p>
              <div class="mt-8 flex items-center gap-2 text-sm font-medium text-warm-600 group-hover:text-gold-600 transition-colors">
                Explorar
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
              </div>
            </div>
            <!-- Decorative circle -->
            <div class="absolute -right-10 -bottom-10 w-40 h-40 rounded-full bg-gold-100/40 group-hover:scale-125 transition-transform duration-700"></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About / Story Section -->
  <section class="py-24 md:py-32 bg-cream overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        
        <!-- Image -->
        <div class="relative" data-animate>
          <div class="relative aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl shadow-warm-300/30">
            <img 
              src="https://www.genspark.ai/api/files/s/sM9VmMts?cache_control=3600" 
              alt="Cada detalle cuenta" 
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <!-- Floating accent -->
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-gold-100 rounded-2xl -z-10"></div>
          <div class="absolute -top-6 -left-6 w-24 h-24 border border-gold-200 rounded-2xl -z-10"></div>
        </div>

        <!-- Content -->
        <div data-animate>
          <span class="text-gold-500 text-xs uppercase tracking-[0.3em] font-medium">Nuestra esencia</span>
          <h2 class="font-serif text-4xl md:text-5xl tracking-tight text-warm-900 mt-3 leading-tight">
            Cada detalle<br/>cuenta
          </h2>
          
          <div class="w-12 h-[1px] bg-gold-400 my-8"></div>
          
          <blockquote class="text-lg md:text-xl text-warm-600 font-light leading-relaxed italic font-serif">
            "En el corazon de cada perfume hay una historia unica, impulsada por nuestra pasion y el deseo de que encuentres la fragancia que te identifique."
          </blockquote>
          
          <p class="text-warm-500 mt-8 leading-relaxed">
            Empaquetamos cada perfume con mimo, asegurando que desde el momento en que recibes tu pedido, la experiencia sea inolvidable. Somos Cristina Barbero y Joaquin Escribano, con mas de 10 anos de experiencia en el sector.
          </p>
          
          <a href="/sobre-nosotros" class="inline-flex items-center gap-3 mt-10 text-sm font-medium text-warm-800 group">
            <span class="border-b border-warm-800 pb-0.5 group-hover:border-gold-500 group-hover:text-gold-700 transition-colors">Descubre nuestra historia</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 group-hover:text-gold-600 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews Section -->
  <section class="py-24 md:py-32 bg-warm-900 relative overflow-hidden grain">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
      
      <!-- Header -->
      <div class="text-center mb-16" data-animate>
        <span class="text-gold-400 text-xs uppercase tracking-[0.3em] font-medium">Testimonios</span>
        <h2 class="font-serif text-4xl md:text-5xl tracking-tight text-white mt-3">
          Lo que dicen nuestros clientes
        </h2>
        <p class="text-warm-500 mt-4 max-w-lg mx-auto">
          Mas de 41 resenas respaldan la calidad y duracion de nuestras fragancias.
        </p>
        
        <!-- Rating summary -->
        <div class="flex items-center justify-center gap-2 mt-6">
          <div class="flex text-gold-400 text-lg tracking-wider">
            &#9733;&#9733;&#9733;&#9733;&#9733;
          </div>
          <span class="text-warm-400 text-sm">4.9 / 5</span>
        </div>
      </div>

      <!-- Reviews Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((review, idx) => (
          <div class="bg-warm-800/50 backdrop-blur-sm border border-warm-700/50 p-8 rounded-2xl hover:border-gold-500/30 transition-all duration-500" data-animate style={`animation-delay: ${idx * 0.1}s`}>
            <!-- Stars -->
            <div class="flex text-gold-400 text-sm mb-5 tracking-wider">
              &#9733;&#9733;&#9733;&#9733;&#9733;
            </div>
            <!-- Quote -->
            <p class="text-warm-300 text-sm leading-relaxed font-light">
              "{review.text}"
            </p>
            <!-- Author -->
            <div class="mt-6 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-gold-500/20 flex items-center justify-center">
                <span class="text-gold-400 text-xs font-semibold">{review.author.charAt(0)}</span>
              </div>
              <span class="text-warm-400 text-sm font-medium">{review.author}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA / Newsletter Banner -->
  <section class="py-24 md:py-32 bg-white">
    <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center" data-animate>
      <span class="text-gold-500 text-xs uppercase tracking-[0.3em] font-medium">Mantente al dia</span>
      <h2 class="font-serif text-4xl md:text-5xl tracking-tight text-warm-900 mt-3">
        No te pierdas nada
      </h2>
      <p class="text-warm-500 mt-4 max-w-md mx-auto">
        Suscribete para recibir novedades, ofertas exclusivas y ser el primero en descubrir nuevas fragancias.
      </p>
      
      <form class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
        <input 
          type="email" 
          placeholder="tu@email.com" 
          class="w-full px-5 py-3.5 bg-warm-50 border border-warm-200 rounded-full text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all"
        />
        <button type="submit" class="w-full sm:w-auto whitespace-nowrap bg-warm-900 text-white px-8 py-3.5 text-sm font-medium rounded-full hover:bg-gold-600 transition-colors duration-300 shadow-sm">
          Suscribirse
        </button>
      </form>
      
      <p class="text-[11px] text-warm-400 mt-4">Sin spam. Puedes darte de baja en cualquier momento.</p>
    </div>
  </section>

</Layout>
