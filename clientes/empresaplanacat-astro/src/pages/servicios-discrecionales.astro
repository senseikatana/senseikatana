<!-- Utility Bar -->
<div class="bg-surface-container-lowest border-b border-surface-variant py-2 px-margin-mobile md:px-margin-desktop text-label-md font-label-md text-on-surface-variant flex justify-end items-center gap-4 hidden md:flex">
<span>CA | ES | EN</span>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">phone</span> +34 977 553 680</span>
</div>
<!-- TopNavBar Shared Component -->
