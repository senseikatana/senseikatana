---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.discretionary.title,
	description: dict.discretionary.hero.subtitle,
	lang: locale,
	ogTitle: dict.discretionary.hero.title,
	ogDescription: dict.discretionary.hero.subtitle,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen";
---

