---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.homeVariant2.title,
	description: dict.home.screens.variant2.desc,
	lang: locale,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background font-body-md text-on-surface antialiased";
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<!-- Utility Bar -->
<div class="w-full bg-surface-container-lowest border-b border-surface-variant hidden md:block">
<div class="max-w-container-max mx-auto px-margin-desktop py-2 flex justify-end items-center gap-gutter text-sm font-label-md text-on-surface-variant">
<div class="flex gap-2 items-center">
<span class="cursor-pointer hover:text-primary">CA</span> | 
                <span class="cursor-pointer hover:text-primary">ES</span> | 
                <span class="cursor-pointer font-bold text-primary">EN</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[18px]">phone</span>
                +34 977 553 680
            </div>
</div>
</div>
<!-- Top Navigation (Shared Component) -->
<nav class="bg-surface dark:bg-inverse-surface docked full-width top-0 z-50 sticky shadow-sm">
<div class="flex justify-between items-center w-full px-margin-desktop max-w-container-max mx-auto h-20">
<!-- Brand -->
<a class="font-headline-md text-headline-md font-bold text-deep-navy dark:text-primary-fixed-dim flex items-center gap-2 text-primary" href="#">
                PLANA <span class="text-on-surface-variant font-light">60</span>
</a>
<!-- Links (Desktop) -->
<div class="hidden md:flex gap-8 items-center h-full">
<a class="text-on-surface-variant dark:text-outline-variant hover:text-secondary-fixed transition-colors duration-200 font-label-md h-full flex items-center border-b-2 border-transparent" href="#">Routes &amp; Schedules</a>
<a class="text-on-surface-variant dark:text-outline-variant hover:text-secondary-fixed transition-colors duration-200 font-label-md h-full flex items-center border-b-2 border-transparent" href="#">Private Services</a>
<a class="text-on-surface-variant dark:text-outline-variant hover:text-secondary-fixed transition-colors duration-200 font-label-md h-full flex items-center border-b-2 border-transparent" href="#">About Us</a>
<a class="text-on-surface-variant dark:text-outline-variant hover:text-secondary-fixed transition-colors duration-200 font-label-md h-full flex items-center border-b-2 border-transparent" href="#">Contact</a>
</div>
<!-- Actions (Desktop) -->
<div class="hidden md:flex items-center gap-4">
<button class="font-button text-button text-on-surface-variant hover:text-primary transition-colors duration-200">Contact</button>
<button class="bg-primary text-on-primary font-button text-button px-6 py-3 rounded hover:opacity-90 transition-opacity">BOOK NOW</button>
</div>
<!-- Mobile Menu Toggle -->
<button class="md:hidden text-primary">
<span class="material-symbols-outlined text-[28px]">menu</span>
</button>
</div>
</nav>
<!-- Split Hero Section -->
<section class="max-w-container-max mx-auto md:px-margin-desktop px-margin-mobile py-stack-lg">
<div class="flex flex-col md:flex-row gap-gutter bg-surface-container-lowest rounded-xl overflow-hidden shadow-ambient">
<!-- Booking Widget (Left) -->
<div class="w-full md:w-5/12 p-8 flex flex-col justify-center">
<div class="flex gap-4 mb-8 border-b border-surface-variant">
<button class="pb-2 border-b-2 border-primary text-primary font-label-md text-label-md font-bold">Booking</button>
<button class="pb-2 border-b-2 border-transparent text-on-surface-variant hover:text-primary font-label-md text-label-md">Destination</button>
<button class="pb-2 border-b-2 border-transparent text-on-surface-variant hover:text-primary font-label-md text-label-md">Passengers</button>
</div>
<form class="flex flex-col gap-stack-md">
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">Origin</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
<input class="w-full pl-10 pr-4 py-3 rounded border border-surface-variant focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-md text-on-surface transition-colors bg-surface-container-lowest" placeholder="Barcelona Airport" type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface-variant">Destination</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
<input class="w-full pl-10 pr-4 py-3 rounded border border-surface-variant focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-md text-on-surface transition-colors bg-surface-container-lowest" placeholder="Salou" type="text"/>
</div>
</div>
<div class="flex gap-4">
<div class="flex flex-col gap-2 w-1/2">
<label class="font-label-md text-label-md text-on-surface-variant">Date</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">calendar_month</span>
<input class="w-full pl-10 pr-4 py-3 rounded border border-surface-variant focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-md text-on-surface transition-colors bg-surface-container-lowest" placeholder="27/07/2026" type="text"/>
</div>
</div>
<div class="flex flex-col gap-2 w-1/2">
<label class="font-label-md text-label-md text-on-surface-variant">Passengers</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">person</span>
<select class="w-full pl-10 pr-4 py-3 rounded border border-surface-variant focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-md text-on-surface transition-colors bg-surface-container-lowest appearance-none">
<option>1 Adult</option>
<option>2 Adults</option>
</select>
</div>
</div>
</div>
<button class="w-full bg-[#EB8E02] text-on-primary font-button text-button py-4 rounded hover:opacity-90 transition-opacity mt-4 shadow-sm" type="button">
                        SEARCH
                    </button>
</form>
</div>
<!-- Hero Image (Right) -->
<div class="w-full md:w-7/12 h-64 md:h-auto min-h-[400px] relative">
<img alt="Empresa Plana Bus" class="absolute inset-0 w-full h-full object-cover" data-alt="A modern, high-quality photograph of a sleek, comfortable Empresa Plana coach bus traveling along a scenic, sunlit Mediterranean coastal road. The lighting is bright and warm, emphasizing the safety and reliability of the modern fleet against a beautiful coastline backdrop, fitting a corporate modern aesthetic." src="https://lh3.googleusercontent.com/aida/AP1WRLuR0px2Ux0FRFwHGZhcyWf4jP8-thYfkTg-Qa9-C0NDlDE89WqHVKUW_V7Hg0Bhyu5wtCeB06RMgrQyVKqq9ea9G47HaWea0cqUfbVlTGjpDLvAL5TSZmlkqRBc6_XcGL6oIVa__QtUFgQWl9QRlaiHrS-THbWgvgczz8HBIZp_u9020eaPbdx9cOZskITDjTlhM7nTQo4K8yGXI5sMX2v9rNQ_xIdJpHM1N4OLNBcL3rg0QdCJt2GmyIk"/>
<!-- Fallback gradient if image fails -->
<div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent pointer-events-none"></div>
</div>
</div>
</section>
<!-- Popular Routes Section -->
<section class="max-w-container-max mx-auto md:px-margin-desktop px-margin-mobile py-stack-lg mb-16">
<h2 class="font-headline-lg text-headline-lg md:font-headline-lg md:text-headline-lg font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary mb-8 uppercase tracking-wide">Popular Routes</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
<!-- Route Card 1 -->
<div class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-ambient border border-surface-variant flex flex-col group cursor-pointer hover:-translate-y-1 transition-transform duration-300">
<div class="h-48 relative overflow-hidden">
<img alt="Barcelona cityscape" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="A stunning, high-resolution aerial photograph of the Barcelona skyline at golden hour. The image features the iconic grid pattern of the Eixample district stretching towards the Mediterranean sea. The lighting is warm and inviting, fitting a premium travel booking platform with a modern, coastal aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDc0qKrqJ33N7LG5LORztZfMfQwjUjfqP2_tOcwbTF8KTqO5nBvQCnpRnNc5JMt5DYnqOXS0hd1GVYpEE_WJH-4a7nvfDcQErAIi4f9FOKmnwn8nENXanEMg-QRpUoFLt4E--dnlAnQ70o59DA9Y55PDD6Y2RCWGG_1WWeRv9-GhaDpPi8XW72l4SXj6gNeYx5nbU46NCa1LRGiigltuCIN5NYIUO4x1p6KFRy52hoT8iS6q69qPOhE"/>
</div>
<div class="p-6 flex flex-col flex-grow">
<h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2">Barcelona</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">Barcelona is a beautiful mediterranean city with a rich history and culture, perfect for your next getaway.</p>
<div class="mt-auto flex justify-between items-end border-t border-surface-variant pt-4">
<span class="font-label-md text-label-md text-outline">Starting from</span>
<span class="font-headline-md text-headline-md font-bold text-primary">€12.50</span>
</div>
</div>
</div>
<!-- Route Card 2 -->
<div class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-ambient border border-surface-variant flex flex-col group cursor-pointer hover:-translate-y-1 transition-transform duration-300">
<div class="h-48 relative overflow-hidden">
<img alt="Salou beach" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="A vibrant, sunny photograph of a beautiful sandy beach in Salou, Spain. The crystal clear turquoise waters of the Mediterranean gently lap the shore, while palm trees sway lightly in the breeze. The scene is bright and cheerful, designed to evoke feelings of a relaxing coastal holiday in a modern travel app." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCS_Y9gPdjXrImUXZ65N5l76nPP7REWGf_VX9OfqxkeKHgxetcQcDGLUDD6Iv9niiV9-dXPcKnQHZiTPpQhExB1wXFH-bwHEY3OMeMmLo14k9d8hJ4lHs3eKUyCvAuFH2Ij0nsCgDXQhmrd3TTLkR_KzXlKD1mk3cY9al0ZH2P38b640MFuQPzVHPSGSFBd4svdCX-nM1TXb0t-JQdkq8BuyuOHxeoVSscAtXtPvDkCsZmcwpfKurFM"/>
</div>
<div class="p-6 flex flex-col flex-grow">
<h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2">Salou</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">Salou is known for its stunning beaches and lively atmosphere on the Mediterranean coast.</p>
<div class="mt-auto flex justify-between items-end border-t border-surface-variant pt-4">
<span class="font-label-md text-label-md text-outline">Starting from</span>
<span class="font-headline-md text-headline-md font-bold text-primary">€12.50</span>
</div>
</div>
</div>
<!-- Route Card 3 -->
<div class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-ambient border border-surface-variant flex flex-col group cursor-pointer hover:-translate-y-1 transition-transform duration-300">
<div class="h-48 relative overflow-hidden">
<img alt="Tarragona coastline" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="A sweeping, picturesque view of the historic coastline of Tarragona. The image captures the blend of ancient Roman ruins overlooking the bright blue Mediterranean sea. The lighting highlights the warm tones of the stone against the cool blues, creating a sophisticated and inviting travel destination visual." src="https://lh3.googleusercontent.com/aida-public/AB6AXuALCTStN1KjKoERi_amy7j_4oDqH_zKta9y-6njpzTeQLcnGGa9bHoIIBTHSl83I8IvImB6EklI4mcgtLkc9PomRpMBzjilrxBjOd2dM67-vTc44k49lIWtM7l0GLP8o_8h0YsnBsskph1Pm5tUw28j2Z9BLwwonwsKcJiTroFWeQ-PqNy6bbchWNmnCMsKOlphHAljt3BmAoelIhxN3DvyuYMyAZCc5Y8xfMUSSqatmt9eOzSAnhhI"/>
</div>
<div class="p-6 flex flex-col flex-grow">
<h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2">Tarragona</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">Tarragona offers a magnificent blend of Roman heritage and beautiful coastal views.</p>
<div class="mt-auto flex justify-between items-end border-t border-surface-variant pt-4">
<span class="font-label-md text-label-md text-outline">Starting from</span>
<span class="font-headline-md text-headline-md font-bold text-primary">€12.50</span>
</div>
</div>
</div>
</div>
</section>
<!-- Footer (Shared Component) -->
<footer class="bg-primary text-on-primary font-body-md text-body-md full-width">
<div class="w-full py-stack-lg px-margin-desktop flex flex-col md:flex-row justify-between items-start gap-gutter max-w-container-max mx-auto border-b border-on-primary/20 pb-12">
<div class="flex flex-col gap-4 w-full md:w-1/4">
<span class="font-headline-md text-headline-md font-bold text-on-primary">Services</span>
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#">Routes &amp; Schedules</a>
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#">Private Services</a>
</div>
<div class="flex flex-col gap-4 w-full md:w-1/4">
<span class="font-headline-md text-headline-md font-bold text-on-primary">Contact info</span>
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#">eempresaplana.com</a>
<span class="text-on-primary/80">+34 977 553 680</span>
</div>
<div class="flex flex-col gap-4 w-full md:w-1/4">
<span class="font-headline-md text-headline-md font-bold text-on-primary">Social Media</span>
<div class="flex gap-4">
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#"><span class="material-symbols-outlined icon-fill">qr_code_2</span></a>
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#"><span class="material-symbols-outlined icon-fill">alternate_email</span></a> <!-- using alternate_email for twitter/x placeholder -->
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#"><span class="material-symbols-outlined icon-fill">photo_camera</span></a> <!-- using photo_camera for instagram placeholder -->
<a class="text-on-primary/80 hover:text-secondary-fixed transition-colors duration-200" href="#"><span class="material-symbols-outlined icon-fill">play_circle</span></a> <!-- using play_circle for youtube placeholder -->
</div>
</div>
<div class="flex flex-col gap-4 w-full md:w-1/4">
<span class="font-headline-md text-headline-md font-bold text-on-primary">Legal Links</span>
<!-- Kept empty as per visual, links are at bottom -->
</div>
</div>
<div class="w-full py-6 px-margin-desktop flex flex-col md:flex-row justify-between items-center gap-4 max-w-container-max mx-auto text-sm text-on-primary/60">
<p>© 2024 Empresa Plana. All rights reserved. Efficient Mobility for the Mediterranean.</p>
<div class="flex gap-6">
<a class="hover:text-on-primary transition-colors" href="#">Privacy Policy</a>
<a class="hover:text-on-primary transition-colors" href="#">Terms of Service</a>
<a class="hover:text-on-primary transition-colors" href="#">Cookies</a>
<a class="hover:text-on-primary transition-colors" href="#">Sitemap</a>
</div>
</div>
</footer>
</BaseLayout>
