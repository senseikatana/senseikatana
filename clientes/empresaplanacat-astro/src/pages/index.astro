---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteInfo, getCanonicalUrl } from '../config/site-info';
import { getLocale, getDictionary, LOCALES } from '../config/i18n';

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get('lang'));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.homeVariant1.title,
	description: dict.home.screens.variant1.desc,
	lang: locale,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});

const b = dict.homeVariant1.booking;
const r = dict.homeVariant1.routes;
const f = dict.homeVariant1.footer;
const c = dict.common;
const pathname = Astro.url.pathname;

const routes = [
	{
		name: r.cards.barcelona.name,
		desc: r.cards.barcelona.desc,
		image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCtSg2gWtEB8iqJEgthzvfBWjXcUrD9VpvBZSBoSGoWjlarrxQOCVQbU2yQNZLW4PLIIwRJQnbehqNOGL5HyuMjHsqFU-1lNoJUJxXDE7bFlSnEOfaQTuK8KuPoDUMTeP_ZAu4gq-kIQpQOafAa31w-5ATVPrg7bFOMgjOl7SfPuPWl1R2vRowXzW9scx3Z19Twp0HQ1aS_ouFNJu2NvLRzHZZij9Tc1N4FecN9C2VxmMJ2hNRMFEQG',
	},
	{
		name: r.cards.salou.name,
		desc: r.cards.salou.desc,
		image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDb-uEalZ2ecrUF64zGVUfZq-y_BPdptVR1aE--86siIhTjWB7O9vlDezGLyglg1r1yYxmhv6csxZJTw9Y-XyDtGjZz3x1r3dT5y37bbK-388zqBa5f3w5QaoH9vP8lIrm_s8l8eMSAWmGxmsONnYna56AygODplpJ8XaM1CLe4oxisPRfaam7kPsmGjqbA4w6YsrB3al9FI3pPsNd-y9xVdR46QG5WWhGp4C4CAOO0e12iNPWEYQKP',
	},
	{
		name: r.cards.tarragona.name,
		desc: r.cards.tarragona.desc,
		image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCwqd2TcKxNrSE6EqwCWD3HA24qZ-BIBL6k9epioWd4oEz3y8jrYfbrqes3u1UGOwt6cht1dsYf2-ifByNk0n0Nd-JC1Vm0XnFfw4VLUZdhjEegxyBNPGR8o8ssOIov20Vo9IzAzyjLIDFN07gJHjasLhDErwABSVUr7HjRHCDMyZJsV4yEQ1izbhfTA0D8qXsa9E-8kYo2Ibm51bwuxidU44Ou7TojOLClzht8i-wpUa_KxkIA6ogm',
	},
];
---

<BaseLayout {...siteInfo} bodyClass="bg-surface text-on-surface min-h-screen flex flex-col">
	<!-- TopNav - Utility Bar -->
	<div class="bg-surface-container-lowest border-b border-surface-variant hidden md:block">
		<div class="max-w-container-max mx-auto px-margin-desktop py-2 flex justify-end items-center gap-gutter font-label-md text-label-md text-on-surface-variant">
			<div class="flex items-center gap-2">
				{LOCALES.map((lang) => (
					<a
						class={`hover:text-primary transition-colors cursor-pointer ${lang === locale ? 'font-bold text-on-surface' : ''}`}
						href={`${pathname}?lang=${lang}`}
					>
						{c.lang[lang]}
					</a>
				)).reduce((prev, curr) => <>{prev}<span class="text-outline-variant"> | </span>{curr}</>)}
			</div>
			<div class="flex items-center gap-2">
				<span aria-hidden="true" class="material-symbols-outlined text-lg">call</span>
				{c.phone}
			</div>
		</div>
	</div>
	<!-- TopNav - Main -->
	<header class="bg-surface sticky top-0 z-50 shadow-[0px_4px_20px_rgba(1,57,144,0.08)]">
		<nav class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto h-20">
			<!-- Logo -->
			<a href="/" class="font-headline-md text-headline-md font-bold text-primary-container flex items-center">
				{c.brand}
			</a>
			<!-- Navigation Links -->
			<div class="hidden md:flex items-center gap-gutter font-button text-button">
				<a class="text-on-surface-variant hover:text-secondary transition-colors duration-200" href="/servicios-discrecionales">{c.nav.services}</a>
				<a class="text-on-surface-variant hover:text-secondary transition-colors duration-200" href="/rutas-horarios">{f.routesSchedules}</a>
				<a class="text-on-surface-variant hover:text-secondary transition-colors duration-200" href="/donde-estamos">{c.nav.locations}</a>
				<a class="text-on-surface-variant hover:text-secondary transition-colors duration-200" href="/rastreig">{dict.home.screens.tracking.label}</a>
				<a class="text-on-surface-variant hover:text-secondary transition-colors duration-200" href="#contacto">{c.nav.contact}</a>
			</div>
			<!-- Mobile Menu Toggle -->
			<button class="md:hidden text-primary-container p-2" aria-label="menu">
				<span aria-hidden="true" class="material-symbols-outlined">menu</span>
			</button>
		</nav>
	</header>
	<main class="flex-grow">
		<!-- Hero Section with Booking Widget -->
		<section class="relative w-full min-h-[600px] flex items-center justify-center pt-10 pb-20 px-margin-mobile md:px-margin-desktop overflow-hidden">
			<!-- Background Image -->
			<div class="absolute inset-0 z-0">
				<img alt="Modern Empresa Plana bus driving along a scenic coastal Mediterranean route during golden hour" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/AP1WRLuR0px2Ux0FRFwHGZhcyWf4jP8-thYfkTg-Qa9-C0NDlDE89WqHVKUW_V7Hg0Bhyu5wtCeB06RMgrQyVKqq9ea9G47HaWea0cqUfbVlTGjpDLvAL5TSZmlkqRBc6_XcGL6oIVa__QtUFgQWl9QRlaiHrS-THbWgvgczz8HBIZp_u9020eaPbdx9cOZskITDjTlhM7nTQo4K8yGXI5sMX2v9rNQ_xIdJpHM1N4OLNBcL3rg0QdCJt2GmyIk"/>
				<div class="absolute inset-0 bg-primary/20 mix-blend-multiply"></div>
			</div>
			<!-- Booking Widget -->
			<div class="relative z-10 w-full max-w-3xl bg-surface-container-lowest/90 backdrop-blur-md rounded-xl shadow-[0px_8px_32px_rgba(1,57,144,0.15)] p-6 md:p-8 border border-surface-variant">
				<!-- Tabs -->
				<div class="flex gap-4 mb-6 border-b border-surface-variant pb-2">
					<button class="font-label-md text-label-md text-primary-container border-b-2 border-primary-container pb-2 -mb-2.5">{b.tabs.booking}</button>
					<button class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors pb-2">{b.tabs.destination}</button>
					<button class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors pb-2">{b.tabs.passengers}</button>
				</div>
				<!-- Form Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md mb-8">
					<div class="flex flex-col gap-1">
						<label class="font-label-md text-label-md text-on-surface-variant">{b.origin}</label>
						<div class="relative">
							<span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
							<input class="w-full pl-10 pr-4 py-3 rounded bg-surface border border-outline-variant focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors font-body-md text-body-md text-on-surface placeholder:text-outline" placeholder={b.originPlaceholder} type="text"/>
						</div>
					</div>
					<div class="flex flex-col gap-1">
						<label class="font-label-md text-label-md text-on-surface-variant">{b.destination}</label>
						<div class="relative">
							<span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
							<input class="w-full pl-10 pr-4 py-3 rounded bg-surface border border-outline-variant focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors font-body-md text-body-md text-on-surface placeholder:text-outline" placeholder={b.destinationPlaceholder} type="text"/>
						</div>
					</div>
					<div class="flex flex-col gap-1">
						<label class="font-label-md text-label-md text-on-surface-variant">{b.date}</label>
						<div class="relative">
							<span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">calendar_today</span>
							<input class="w-full pl-10 pr-4 py-3 rounded bg-surface border border-outline-variant focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors font-body-md text-body-md text-on-surface placeholder:text-outline" placeholder={b.datePlaceholder} type="text"/>
						</div>
					</div>
					<div class="flex flex-col gap-1">
						<label class="font-label-md text-label-md text-on-surface-variant">{b.passengers}</label>
						<div class="relative">
							<span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">person</span>
							<input class="w-full pl-10 pr-4 py-3 rounded bg-surface border border-outline-variant focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors font-body-md text-body-md text-on-surface placeholder:text-outline" placeholder={b.passengersPlaceholder} type="text"/>
						</div>
					</div>
				</div>
				<!-- Action -->
				<div class="flex justify-center">
					<button class="bg-energetic-orange hover:opacity-90 text-on-primary font-button text-button py-4 px-12 rounded-lg transition-opacity w-full md:w-auto shadow-md">
						{b.search}
					</button>
				</div>
			</div>
		</section>
		<!-- Popular Routes Section -->
		<section class="py-16 md:py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
			<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary-container mb-10 text-center md:text-left">
				{r.title}
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
				{routes.map((route) => (
					<div class="bg-surface-container-lowest rounded-2xl overflow-hidden border border-surface-variant shadow-[0px_4px_20px_rgba(1,57,144,0.05)] hover:shadow-[0px_8px_32px_rgba(1,57,144,0.12)] transition-shadow duration-300 flex flex-col">
						<div class="h-48 relative overflow-hidden bg-surface-variant">
							<img class="w-full h-full object-cover" alt={route.name} src={route.image}/>
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2">{route.name}</h3>
							<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">{route.desc}</p>
							<div class="mt-auto flex justify-between items-center pt-4 border-t border-surface-variant">
								<span class="font-body-md text-body-md text-outline">{r.startingFrom}</span>
								<span class="font-headline-md text-headline-md font-bold text-primary-container">{r.price}</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>
	</main>
	<!-- Footer -->
	<footer id="contacto" class="bg-primary-container text-on-primary mt-auto">
		<div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
				<!-- Services -->
				<div>
					<h4 class="font-label-md text-label-md font-bold mb-4 opacity-80">{f.services}</h4>
					<ul class="flex flex-col gap-2 font-body-md text-body-md">
						<li><a class="hover:text-secondary-fixed transition-colors" href="/rutas-horarios">{f.routesSchedules}</a></li>
						<li><a class="hover:text-secondary-fixed transition-colors" href="/servicios-discrecionales">{f.privateServices}</a></li>
						<li><a class="hover:text-secondary-fixed transition-colors" href="/rastreig">{dict.home.screens.tracking.label}</a></li>
					</ul>
				</div>
				<!-- Contact Info -->
				<div>
					<h4 class="font-label-md text-label-md font-bold mb-4 opacity-80">{f.contact}</h4>
					<ul class="flex flex-col gap-2 font-body-md text-body-md">
						<li><a class="hover:text-secondary-fixed transition-colors" href="mailto:info@empresaplana.cat">info@empresaplana.cat</a></li>
						<li><a class="hover:text-secondary-fixed transition-colors" href="tel:+34977553680">{c.phone}</a></li>
					</ul>
				</div>
				<!-- Social Media -->
				<div>
					<h4 class="font-label-md text-label-md font-bold mb-4 opacity-80">{f.social}</h4>
					<div class="flex gap-4">
						<a class="hover:text-secondary-fixed transition-colors" href="https://www.facebook.com/BusPlana"><span aria-hidden="true" class="material-symbols-outlined">qr_code_2</span></a>
						<a class="hover:text-secondary-fixed transition-colors" href="https://twitter.com/BusPlanaOficial"><span aria-hidden="true" class="material-symbols-outlined">chat</span></a>
						<a class="hover:text-secondary-fixed transition-colors" href="https://www.instagram.com/busplana/"><span aria-hidden="true" class="material-symbols-outlined">photo_camera</span></a>
						<a class="hover:text-secondary-fixed transition-colors" href="https://www.youtube.com/user/busplana"><span aria-hidden="true" class="material-symbols-outlined">smart_display</span></a>
					</div>
				</div>
				<!-- Legal Links (Desktop only, mobile moves to bottom) -->
				<div class="hidden md:block">
					<h4 class="font-label-md text-label-md font-bold mb-4 opacity-80">{f.legal}</h4>
					<ul class="flex flex-col gap-2 font-body-md text-body-md">
						<li><a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.privacy}</a></li>
						<li><a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.terms}</a></li>
					</ul>
				</div>
			</div>
			<!-- Bottom Footer -->
			<div class="border-t border-on-primary/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 font-body-md text-body-md text-on-primary/80">
				<p>{c.footer.copyright}</p>
				<div class="flex gap-6">
					<a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.privacy}</a>
					<a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.terms}</a>
					<a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.cookies}</a>
					<a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.contact}</a>
					<a class="hover:text-secondary-fixed transition-colors" href="#">{c.footer.fleet}</a>
					<a class="hover:text-secondary-fixed transition-colors" href="/screens">{dict.home.title}</a>
				</div>
			</div>
		</div>
	</footer>
</BaseLayout>
