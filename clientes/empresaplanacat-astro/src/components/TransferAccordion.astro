---
import type { TransferOption } from "../lib/search";
import type { RoutesResults } from "../config/i18n/types";
import RouteAccordion from "./RouteAccordion.astro";

interface Props {
	transfer: TransferOption;
	t: RoutesResults;
	index?: number;
}

const { transfer, t, index = 0 } = Astro.props;
---

<details
	class="group bg-surface-tint/5 rounded-xl border border-coastal-teal/30 ambient-shadow overflow-hidden"
	open={index === 0}
>
	<summary class="cursor-pointer list-none flex items-center justify-between gap-3 p-5">
		<div class="flex items-center gap-3">
			<span class="material-symbols-outlined text-coastal-teal">sync_alt</span>
			<span class="font-headline-md text-headline-md text-deep-navy">
				{t.hubLabel} <span class="text-coastal-teal">{transfer.hub}</span>
			</span>
		</div>
		<span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform">expand_more</span>
	</summary>
	<div class="px-5 pb-6 flex flex-col gap-4 border-t border-outline-variant/20 pt-5">
		<RouteAccordion line={transfer.firstLeg} t={t} index={-1} legLabel={`${t.legLabel} 1`} />
		<RouteAccordion line={transfer.secondLeg} t={t} index={-1} legLabel={`${t.legLabel} 2`} />
	</div>
</details>
