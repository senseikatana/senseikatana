# Turso database (libSQL) — create one at https://turso.tech
# Credentials are NEVER committed; copy this file to .env and fill in real values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=your-auth-token
AUTH_SECRET=

# Google Sheets sync (service account JSON path + spreadsheet id)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
