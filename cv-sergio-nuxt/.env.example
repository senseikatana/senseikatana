# --- Site ---
SITE_URL=http://localhost:3000

# --- Contact: PRIVADO, nunca se publica ---
#
# These do NOT go in content/resume/*.json. @nuxt/content would
# serialise them into _payload.json, which the browser downloads
# unasked, so the digits would be public no matter what the
# template hides.
#
# Instead /contact/call and /contact/whatsapp resolve server-side
# via a 302. Copy this file to .env and fill in the real values.
# .env is gitignored: never commit the actual numbers.
# ---

# E.164 format, used for the tel: target.
# Example: +34 637 723 747
NUXT_CONTACT_PHONE=

# Digits only: country code + number, no +, spaces or dashes.
# This is what wa.me expects. Same number as above.
# Example: 34637723747
NUXT_CONTACT_WHATSAPP=
