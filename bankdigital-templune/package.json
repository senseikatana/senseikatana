{
  "name": "bankdigital-templune",
  "version": "0.1.0",
  "description": "Proyecto React con Bun",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "bun build index.html --outdir dist --target browser --minify --sourcemap",
    "preview": "bun --hot dist/index.html",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules bun.lock bun.lockb"
  },
  "keywords": [
    "bun",
    "react",
    "typescript",
    "template"
  ],
  "author": "samuraicoderdev",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "trustedDependencies": []
}
