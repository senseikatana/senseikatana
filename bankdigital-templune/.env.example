# Configuración de bankdigital-templune
# Copia este archivo a .env y configura tu entorno

# Solo las variables con el prefijo BUN_PUBLIC_* se exponen al cliente
# (ver bunfig.toml -> [serve.static].env). Útil para la base de la API de TanStack Query.
BUN_PUBLIC_API_URL=https://jsonplaceholder.typicode.com/posts?_limit=5
