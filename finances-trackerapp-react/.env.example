# Template de variables de entorno para Vite
# Copia este archivo a `.env` para desarrollo local y personaliza los valores.
# NOTA: En Vite, solo las variables que comiencen con `VITE_` se expondrán al cliente.

# Firebase Client Config (obtén estos valores en Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: en producción, URL directa de la función Firebase
# VITE_ASSISTANT_API_URL=https://europe-west1-PROJECT_ID.cloudfunctions.net/assistantChat

# Opcional: usa emuladores locales (firebase emulators:start)
VITE_USE_EMULATORS=false

# Entorno de ejecución
VITE_APP_ENV=development