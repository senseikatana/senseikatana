{
  "name": "singha-beer-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names dev,types --prefix-colors blue,yellow \"vinxi dev\" \"bun run typecheck:watch\"",
    "dev:server": "vinxi dev",
    "dev:types": "bun run typecheck:watch",
    "dev:clean": "rm -rf .vinxi .output && bun run dev",
    "dev:db": "concurrently --names dev,db --prefix-colors blue,green \"vinxi dev\" \"bun run db:studio\"",
    "build": "vinxi build",
    "build:static": "BUILD_PRESET=static vinxi build",
    "build:analyze": "vinxi build --analyze",
    "preview": "vinxi start",
    "preview:static": "npx serve .output/public -l 3000",
    "start": "vinxi start",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "echo 'Add seed script if needed'",
    "clean": "rm -rf .vinxi .output node_modules",
    "clean:cache": "rm -rf .vinxi .output .bun-cache",
    "clean:modules": "rm -rf node_modules bun.lock",
    "reset": "bun run clean:cache && bun install",
    "prepare": "bun run typecheck",
    "prebuild": "bun run typecheck",
    "postinstall": "echo '✨ Dependencies installed successfully!'",
    "info": "bun --version && node --version && echo 'Singha Beer Landing ready!'",
    "deploy:vercel": "bun run build && vercel --prod",
    "deploy:gh-pages": "bun run build:static && gh-pages -d .output/public"
  },
  "dependencies": {
    "@corvu/accordion": "^0.2.0",
    "@kobalte/core": "^0.13.0",
    "@solidjs/meta": "^0.29.0",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.0",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "vinxi": "^0.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22"
  }
}
