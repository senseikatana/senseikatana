---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar sesion - NUM Perfume">
  <section class="min-h-screen flex">
    
    <!-- Left side - Image -->
    <div class="hidden lg:block lg:w-1/2 relative overflow-hidden">
      <img 
        src="https://www.genspark.ai/api/files/s/MmekJO3k?cache_control=3600" 
        alt="NUM Perfume Collection" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-warm-900/40 to-warm-900/20"></div>
      
      <!-- Floating quote -->
      <div class="absolute bottom-16 left-12 right-12 z-10">
        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-8">
          <p class="font-serif text-white text-lg italic leading-relaxed">
            "Un perfume no solo se lleva, se vive."
          </p>
          <p class="text-white/60 text-sm mt-3">- NUM Perfume</p>
        </div>
      </div>
    </div>

    <!-- Right side - Form -->
    <div class="w-full lg:w-1/2 flex items-center justify-center px-6 py-20 bg-cream">
      <div class="w-full max-w-md">
        
        <!-- Logo -->
        <div class="mb-12">
          <a href="/" class="inline-block">
            <span class="font-serif text-3xl tracking-tight text-warm-900">NUM</span>
            <span class="text-[10px] uppercase tracking-[0.3em] text-warm-500 block -mt-1">perfume</span>
          </a>
        </div>
        
        <!-- Heading -->
        <div class="mb-10">
          <h1 class="font-serif text-3xl md:text-4xl text-warm-900 tracking-tight">
            Bienvenido de nuevo
          </h1>
          <p class="text-warm-500 mt-2 text-sm">
            Inicia sesion para acceder a tus pedidos y favoritos.
          </p>
        </div>

        <!-- Error message -->
        <div id="error-message" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>

        <!-- Form -->
        <form id="login-form" class="space-y-6">
          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-warm-600 font-medium mb-2">
              Correo electronico
            </label>
            <input 
              id="email" 
              name="email" 
              type="email" 
              autocomplete="email" 
              required 
              class="w-full px-4 py-3.5 bg-white border border-warm-200 rounded-xl text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all duration-300" 
              placeholder="tu@email.com"
            />
          </div>
          
          <div>
            <label for="password" class="block text-xs uppercase tracking-widest text-warm-600 font-medium mb-2">
              Contrasena
            </label>
            <input 
              id="password" 
              name="password" 
              type="password" 
              autocomplete="current-password" 
              required 
              class="w-full px-4 py-3.5 bg-white border border-warm-200 rounded-xl text-sm text-warm-800 placeholder:text-warm-400 focus:outline-none focus:border-gold-400 focus:ring-2 focus:ring-gold-100 transition-all duration-300" 
              placeholder="........"
            />
          </div>

          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer">
              <input 
                type="checkbox" 
                name="remember-me" 
                class="w-4 h-4 rounded border-warm-300 text-gold-500 focus:ring-gold-400 focus:ring-offset-0"
              />
              <span class="text-sm text-warm-600">Recordarme</span>
            </label>
            <button type="button" id="forgot-password" class="text-sm text-gold-600 hover:text-gold-700 font-medium transition-colors">
              He olvidado mi contrasena
            </button>
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-warm-900 text-white py-3.5 rounded-xl text-sm font-medium tracking-wide hover:bg-gold-600 transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-gold-200/30"
          >
            Iniciar sesion
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-8">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-warm-200"></div>
          </div>
          <div class="relative flex justify-center">
            <span class="bg-cream px-4 text-xs text-warm-400 uppercase tracking-widest">o continua con</span>
          </div>
        </div>

        <!-- Social Login -->
        <button class="w-full flex items-center justify-center gap-3 py-3.5 bg-white border border-warm-200 rounded-xl text-sm font-medium text-warm-700 hover:border-warm-300 hover:bg-warm-50 transition-all duration-300">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Google
        </button>

        <!-- Register link -->
        <p class="text-center text-sm text-warm-500 mt-8">
          No tienes cuenta? 
          <a href="/signup" class="text-gold-600 hover:text-gold-700 font-medium transition-colors">Crear una cuenta</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { auth, signInWithEmailAndPassword, sendPasswordResetEmail } from '../lib/firebase';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const forgotBtn = document.getElementById('forgot-password') as HTMLButtonElement;

  function showError(message: string) {
    errorDiv.textContent = message;
    errorDiv.classList.remove('hidden');
  }

  function hideError() {
    errorDiv.classList.add('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Iniciando sesion...';

    try {
      await signInWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
      window.location.href = '/';
    } catch (error: any) {
      const messages: Record<string, string> = {
        'auth/user-not-found': 'No existe una cuenta con este correo.',
        'auth/wrong-password': 'Contrasena incorrecta.',
        'auth/invalid-email': 'Correo electronico invalido.',
        'auth/too-many-requests': 'Demasiados intentos. Intenta de nuevo mas tarde.',
        'auth/invalid-credential': 'Credenciales invalidas.',
      };
      showError(messages[error.code] || 'Error al iniciar sesion. Intenta de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Iniciar sesion';
    }
  });

  forgotBtn?.addEventListener('click', async () => {
    const email = emailInput.value;
    if (!email) {
      showError('Ingresa tu correo para recuperar la contrasena.');
      return;
    }
    try {
      await sendPasswordResetEmail(auth, email);
      showError('Correo de recuperacion enviado. Revisa tu bandeja.');
      errorDiv.classList.remove('bg-red-50', 'border-red-200', 'text-red-700');
      errorDiv.classList.add('bg-green-50', 'border-green-200', 'text-green-700');
    } catch {
      showError('Error al enviar el correo de recuperacion.');
    }
  });
</script>
