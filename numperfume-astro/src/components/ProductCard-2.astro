---
interface Props {
  id: string;
  name: string;
  inspiration: string;
  price: number;
  imageUrl: string;
  isNew?: boolean;
}

const { id, name, inspiration, price, imageUrl, isNew = false } = Astro.props;
---

<div class="group relative flex flex-col bg-white">
  <!-- Imagen del Producto -->
  <a href={`/producto/${id}`} class="relative overflow-hidden aspect-[4/5] bg-gray-100 mb-4 block">
    {isNew && (
      <span class="absolute top-3 left-3 bg-black text-white text-[10px] uppercase font-bold tracking-wider px-2 py-1 z-10">
        Nuevo
      </span>
    )}
    <!-- Placeholder para la imagen. En producción usar <Image /> de Astro -->
    <img 
      src={imageUrl} 
      alt={`Perfume ${name}`} 
      class="object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-700 ease-in-out"
      loading="lazy"
    />
    
    <!-- Botón Añadir rápido (Aparece en Hover) -->
    <div class="absolute bottom-0 left-0 w-full p-4 translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 z-20">
      <button class="w-full bg-black text-white text-sm font-semibold py-3 hover:bg-[var(--accent)] transition-colors">
        Añadir al Carrito
      </button>
    </div>
  </a>

  <!-- Información del Producto -->
  <div class="text-center px-2 flex flex-col flex-grow">
    <h3 class="text-sm font-bold text-gray-900 tracking-wide mb-1">
      <a href={`/producto/${id}`}>{name}</a>
    </h3>
    <p class="text-xs text-gray-500 mb-2 font-serif italic line-clamp-1">{inspiration}</p>
    <p class="text-sm font-semibold text-gray-900 mt-auto">{price.toFixed(2).replace('.', ',')} €</p>
  </div>
</div>
