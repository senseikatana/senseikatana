---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../features/services/components/ServiceCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getServices } from '../../features/services/queries';
import { getLocale, useTranslations } from '../../i18n';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
const services = await getServices();
---

<Base title={tr('services.title')} description={tr('services.subtitle')}>
  <Section top={false} inner="px-6 pt-16 pb-14 max-md:px-5">
    <SectionHead
      idx="01"
      label={tr('services.label')}
      title={tr('services.headline')}
      lede={tr('services.subtitle')}
      size="lg"
    />
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5">
    <ul class="grid grid-cols-1 sm:grid-cols-2 border-t border-l border-rule">
      {
        services.map((service) => (
          <li>
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaSection title={tr('services.ctaTitle')} lede={tr('services.ctaBody')} />
</Base>
