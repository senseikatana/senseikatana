---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../features/works/components/WorkCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getWorks } from '../../features/works/queries';
import { getLocale, useTranslations } from '../../i18n';

const tr = useTranslations(getLocale(Astro.url.pathname, Astro.currentLocale));
const works = await getWorks();
---

<Base title={tr('works.title')} description={tr('works.subtitle')}>
  <Section top={false} inner="px-6 pt-16 pb-14 max-md:px-5">
    <SectionHead
      idx="01"
      label={tr('works.label')}
      title={tr('works.headline')}
      lede={tr('works.subtitle')}
      size="lg"
    />
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5">
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        works.map((work) => (
          <li class="contents">
            <WorkCard work={work} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaSection title={tr('works.ctaTitle')} lede={tr('works.ctaBody')} />
</Base>
